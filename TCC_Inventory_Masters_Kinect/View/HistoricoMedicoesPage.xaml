<UserControl x:Class="TCC_Inventory_Masters_Kinect.View.HistoricoMedicoesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             Height="600"
             Width="900">

    <Grid>

        <Border Background="White"
                CornerRadius="18"
                Padding="28"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,20">

                    <TextBlock Text="Histórico de Medições"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="Últimas medições registradas no banco SQLite local."
                               FontSize="15"
                               Foreground="#64748B"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding HistoricoMedicoes}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          RowHeight="36"
                          FontSize="14">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="80"/>

                        <DataGridTextColumn Header="Volume"
                                            Binding="{Binding VolumeCm3}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Data/Hora"
                                            Binding="{Binding DataHora}"
                                            Width="220"/>

                        <DataGridTextColumn Header="Kinect"
                                            Binding="{Binding KinectLigado}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Calibrado"
                                            Binding="{Binding Calibrado}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="180"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</UserControl>