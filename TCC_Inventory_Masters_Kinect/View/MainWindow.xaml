<Window x:Class="TCC_Inventory_Masters_Kinect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TCC_Inventory_Masters_Kinect"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <TextBlock Text="{Binding Status}"
                   FontSize="20"
                   Margin="10"/>

            <TextBlock Text="{Binding VolumeTexto}"
                   FontSize="20"
                   Margin="10"/>

            <Button Content="Ligar Kinect"
                Command="{Binding LigarKinectCommand}"
                Width="150"
                Height="40"
                Margin="10"/>

            <Button Content="Desligar Kinect"
                Command="{Binding DesligarKinectCommand}"
                Width="150"
                Height="40"
                Margin="10"/>

        </StackPanel>

    </Grid>
</Window>
