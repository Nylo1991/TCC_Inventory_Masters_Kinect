<mah:MetroWindow x:Class="TCC_Inventory_Masters_Kinect.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:vm="clr-namespace:TCC_Inventory_Masters_Kinect.ViewModel"
                 Title="Inventory Masters"
                 Height="720"
                 Width="1200"
                 WindowStartupLocation="CenterScreen"
                 Background="#EEF2F7"
                 GlowBrush="#4F46E5"
                 BorderThickness="1"
                 ResizeMode="CanResize"
                 ShowTitleBar="True"
                 WindowTitleBrush="#4F46E5"
                 TitleForeground="White">

    <mah:MetroWindow.DataContext>
        <vm:MainViewModel/>
    </mah:MetroWindow.DataContext>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock Text="Inventory Masters"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#4F46E5"/>

            <TextBlock Text="Mapeamento Inteligente de Espaços com Kinect"
                       FontSize="18"
                       Foreground="#64748B"/>
        </StackPanel>

        <!-- CONTEÚDO -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- PAINEL CADASTRO -->

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="15"
                    Padding="25"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="Cadastro do Espaço"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,0,0,25"/>

                    <TextBlock Text="Nome do Espaço"
                               FontSize="15"
                               Foreground="#475569"/>

                    <TextBox Height="40"
                             Margin="0,5,0,15"
                             Text="{Binding NomeEspaco}"/>

                    <TextBlock Text="Volume Máximo (cm³)"
                               FontSize="15"
                               Foreground="#475569"/>

                    <TextBox Height="40"
                             Margin="0,5,0,15"
                             Text="{Binding VolumeMaximo}"/>

                    <TextBlock Text="Percentual de Alerta (%)"
                               FontSize="15"
                               Foreground="#475569"/>

                    <TextBox Height="40"
                             Margin="0,5,0,25"
                             Text="{Binding PercentualAlerta}"/>

                    <Button Content="Iniciar Mapeamento"
                            Height="50"
                            Background="#4F46E5"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <!-- ÁREA DE VISUALIZAÇÃO -->

            <Border Grid.Column="1"
                    Margin="20,0,0,0"
                    Background="White"
                    CornerRadius="15"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <Grid>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Área de Mapeamento"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#4F46E5"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="A câmera Kinect aparecerá aqui após iniciar o mapeamento."
                                   Margin="0,15,0,0"
                                   FontSize="16"
                                   TextAlignment="Center"
                                   Foreground="#64748B"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</mah:MetroWindow>