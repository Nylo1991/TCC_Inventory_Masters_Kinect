<Window x:Class="TCC_Inventory_Masters_Kinect.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Masters"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F7">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock Text="Inventory Masters"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#4F46E5"/>

            <TextBlock Text="Mapeamento Inteligente de Espaços com Kinect"
                       FontSize="18"
                       Foreground="#64748B"/>

        </StackPanel>

        <!-- CONTEÚDO -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- PAINEL CADASTRO -->

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="15"
                    Padding="25"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Cadastro do Espaço"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"
                                   Margin="0,0,0,25"/>

                        <TextBlock Text="Nome do Espaço"
                                   FontSize="15"
                                   Foreground="#475569"/>

                        <TextBox Height="40"
                                 Margin="0,5,0,15"
                                 Text="{Binding NomeEspaco, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Volume Máximo (cm³)"
                                   FontSize="15"
                                   Foreground="#475569"/>

                        <TextBox Height="40"
                                 Margin="0,5,0,15"
                                 Text="{Binding VolumeMaximo, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Percentual de Alerta (%)"
                                   FontSize="15"
                                   Foreground="#475569"/>

                        <TextBox Height="40"
                                 Margin="0,5,0,25"
                                 Text="{Binding PercentualAlerta, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="Iniciar Mapeamento"
                                Height="50"
                                Background="#4F46E5"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="Bold"
                                Command="{Binding LigarKinectCommand}"/>

                        <Button Content="Calibrar Chão"
                                Height="45"
                                Margin="0,15,0,0"
                                Background="#0F766E"
                                Foreground="White"
                                FontSize="15"
                                FontWeight="Bold"
                                Command="{Binding CalibrarCommand}"/>

                        <Button Content="Desligar Kinect"
                                Height="45"
                                Margin="0,15,0,0"
                                Background="#DC2626"
                                Foreground="White"
                                FontSize="15"
                                FontWeight="Bold"
                                Command="{Binding DesligarKinectCommand}"/>

                        <!-- INFORMAÇÕES CAPTURADAS -->

                        <TextBlock Text="Informações capturadas"
                                   Margin="0,25,0,10"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                        <TextBlock Text="{Binding VolumeTexto}"
                                   Margin="0,5,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#4F46E5"/>

                        <TextBlock Text="{Binding QuantidadePontos3D}"
                                   Margin="0,8,0,0"
                                   FontSize="15"
                                   Foreground="#334155"/>

                        <TextBlock Text="{Binding PercentualOcupacaoTexto}"
                                   Margin="0,5,0,0"
                                   FontSize="15"
                                   Foreground="#334155"/>

                        <TextBlock Text="{Binding EspacoLivreTexto}"
                                   Margin="0,5,0,0"
                                   FontSize="15"
                                   Foreground="#334155"/>

                        <TextBlock Text="{Binding UltimoSnapshot}"
                                   Margin="0,5,0,0"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Foreground="#334155"/>

                        <TextBlock Text="Status"
                                   Margin="0,20,0,5"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                        <TextBlock Text="{Binding Status}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Foreground="#64748B"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

            <!-- ÁREA DE VISUALIZAÇÃO -->

            <Border Grid.Column="1"
                    Margin="20,0,0,0"
                    Background="White"
                    CornerRadius="15"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <Grid>

                    <Image Source="{Binding CameraImage}"
                           Stretch="Uniform"
                           Margin="20"/>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Área de Mapeamento"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#4F46E5"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="A câmera Kinect aparecerá aqui após iniciar o mapeamento."
                                   Margin="0,15,0,0"
                                   FontSize="16"
                                   TextAlignment="Center"
                                   Foreground="#64748B"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>