<Window x:Class="TCC_Inventory_Masters_Kinect.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:TCC_Inventory_Masters_Kinect.View"
        Title="Inventory Masters"
        Height="600"
        Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F7">

    <Window.Resources>

        <Style x:Key="MenuButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="42"/>
            <Setter Property="Margin"
                    Value="0,0,10,0"/>
            <Setter Property="Padding"
                    Value="18,0"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="Foreground"
                    Value="#1E293B"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Left">

                <TextBlock Text="Inventory Masters"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="#4F46E5"/>

                <TextBlock Text="Mapeamento Inteligente de Espaços com Kinect"
                           FontSize="18"
                           Foreground="#64748B"/>
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="White"
                    CornerRadius="14"
                    Padding="22,12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <TextBlock Text="Sistema Kinect"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>
            </Border>

        </Grid>

        <!-- MENU DE PÁGINAS -->

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,25">

            <Button Content="Kinect / Mapeamento"
                    Style="{StaticResource MenuButtonStyle}"
                    Command="{Binding AbrirPaginaKinectCommand}"/>

            <Button Content="Cadastro do Espaço"
                    Style="{StaticResource MenuButtonStyle}"
                    Command="{Binding AbrirPaginaCadastroCommand}"/>

            <Button Content="Histórico de Medições"
                    Style="{StaticResource MenuButtonStyle}"
                    Command="{Binding AbrirPaginaHistoricoCommand}"/>

        </StackPanel>

        <!-- ÁREA QUE MUDA DE PÁGINA -->

        <ContentControl Grid.Row="2"
                        Content="{Binding PaginaAtual}"/>

    </Grid>

</Window>