<Window x:Class="TCC_Inventory_Masters_Kinect.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Masters"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F7">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Inventory Masters"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#4F46E5"/>

            <TextBlock Text="Mapeamento Inteligente de Espaços com Kinect"
                       FontSize="18"
                       Foreground="#64748B"/>

        </StackPanel>

        <!-- ABAS PRINCIPAIS -->

        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0">

            <!-- ========================================== -->
            <!-- ABA 1: KINECT / MAPEAMENTO -->
            <!-- ========================================== -->

            <TabItem Header="Kinect / Mapeamento">

                <Grid Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- PAINEL DE CONTROLE -->

                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="15"
                            Padding="25"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <StackPanel>

                                <!-- CONTROLE DO KINECT -->

                                <TextBlock Text="Controle do Kinect"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"
                                           Margin="0,0,0,20"/>

                                <Button Content="Iniciar Mapeamento"
                                        Height="50"
                                        Background="#4F46E5"
                                        Foreground="White"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Command="{Binding LigarKinectCommand}"/>

                                <Button Content="Calibrar Chão"
                                        Height="45"
                                        Margin="0,15,0,0"
                                        Background="#0F766E"
                                        Foreground="White"
                                        FontSize="15"
                                        FontWeight="Bold"
                                        Command="{Binding CalibrarCommand}"/>

                                <Button Content="Desligar Kinect"
                                        Height="45"
                                        Margin="0,15,0,0"
                                        Background="#DC2626"
                                        Foreground="White"
                                        FontSize="15"
                                        FontWeight="Bold"
                                        Command="{Binding DesligarKinectCommand}"/>

                                <!-- STATUS VISUAL DE CONEXÃO -->

                                <TextBlock Text="Status de Conexão"
                                           Margin="0,25,0,10"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"/>

                                <Border Background="#F8FAFC"
                                        CornerRadius="10"
                                        Padding="12"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1">

                                    <StackPanel>

                                        <TextBlock Text="{Binding StatusKinect}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#334155"
                                                   Margin="0,0,0,6"/>

                                        <TextBlock Text="{Binding StatusSQLite}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#334155"
                                                   Margin="0,0,0,6"/>

                                        <TextBlock Text="{Binding StatusSignalR}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#334155"
                                                   Margin="0,0,0,6"/>

                                        <TextBlock Text="{Binding StatusMvcFirebase}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#334155"/>

                                    </StackPanel>

                                </Border>

                                <!-- INFORMAÇÕES CAPTURADAS -->

                                <TextBlock Text="Informações Capturadas"
                                           Margin="0,25,0,10"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"/>

                                <TextBlock Text="{Binding VolumeTexto}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#4F46E5"/>

                                <TextBlock Text="{Binding QuantidadePontos3D}"
                                           Margin="0,10,0,0"
                                           FontSize="15"
                                           Foreground="#334155"/>

                                <TextBlock Text="{Binding PercentualOcupacaoTexto}"
                                           Margin="0,5,0,0"
                                           FontSize="15"
                                           Foreground="#334155"/>

                                <TextBlock Text="{Binding EspacoLivreTexto}"
                                           Margin="0,5,0,0"
                                           FontSize="15"
                                           Foreground="#334155"/>

                                <TextBlock Text="{Binding UltimoSnapshot}"
                                           Margin="0,5,0,0"
                                           FontSize="15"
                                           TextWrapping="Wrap"
                                           Foreground="#334155"/>

                                <!-- MENSAGEM DO SISTEMA -->

                                <TextBlock Text="Mensagem do Sistema"
                                           Margin="0,25,0,5"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"/>

                                <TextBlock Text="{Binding Status}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Foreground="#64748B"/>

                            </StackPanel>

                        </ScrollViewer>

                    </Border>

                    <!-- ÁREA DE VISUALIZAÇÃO -->

                    <Border Grid.Column="1"
                            Margin="20,0,0,0"
                            Background="White"
                            CornerRadius="15"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1">

                        <Grid>

                            <Image Source="{Binding CameraImage}"
                                   Stretch="Uniform"
                                   Margin="20"/>

                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        IsHitTestVisible="False">

                                <TextBlock Text="Área de Mapeamento"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#4F46E5"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="A câmera Kinect aparecerá aqui após iniciar o mapeamento."
                                           Margin="0,15,0,0"
                                           FontSize="16"
                                           TextAlignment="Center"
                                           Foreground="#64748B"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>

            </TabItem>

            <!-- ========================================== -->
            <!-- ABA 2: CADASTRO DO ESPAÇO -->
            <!-- ========================================== -->

            <TabItem Header="Cadastro do Espaço">

                <Border Margin="0,20,0,0"
                        Background="White"
                        CornerRadius="15"
                        Padding="30"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- FORMULÁRIO -->

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,40,0">

                            <TextBlock Text="Cadastro do Espaço"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Preencha os dados do espaço que será monitorado pelo Kinect."
                                       FontSize="16"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,30"/>

                            <TextBlock Text="Nome do Espaço"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#475569"/>

                            <TextBox Height="42"
                                     Margin="0,6,0,18"
                                     FontSize="15"
                                     Text="{Binding NomeEspaco, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Volume Máximo Permitido (cm³)"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#475569"/>

                            <TextBox Height="42"
                                     Margin="0,6,0,18"
                                     FontSize="15"
                                     Text="{Binding VolumeMaximo, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Percentual de Alerta (%)"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#475569"/>

                            <TextBox Height="42"
                                     Margin="0,6,0,25"
                                     FontSize="15"
                                     Text="{Binding PercentualAlerta, UpdateSourceTrigger=PropertyChanged}"/>

                            <Border Background="#EEF2FF"
                                    CornerRadius="10"
                                    Padding="15"
                                    BorderBrush="#C7D2FE"
                                    BorderThickness="1">

                                <TextBlock Text="Após preencher os dados, volte para a aba Kinect / Mapeamento e clique em Iniciar Mapeamento. O espaço será associado à leitura atual."
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Foreground="#3730A3"/>

                            </Border>

                        </StackPanel>

                        <!-- RESUMO DO CADASTRO -->

                        <Border Grid.Column="1"
                                Background="#F8FAFC"
                                CornerRadius="15"
                                Padding="25"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">

                            <StackPanel>

                                <TextBlock Text="Resumo do Espaço"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"
                                           Margin="0,0,0,20"/>

                                <TextBlock Text="Nome cadastrado"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"/>

                                <TextBlock Text="{Binding NomeEspaco}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#4F46E5"
                                           Margin="0,5,0,20"/>

                                <TextBlock Text="Volume máximo"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"/>

                                <TextBlock FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"
                                           Margin="0,5,0,20">
                                    <Run Text="{Binding VolumeMaximo}"/>
                                    <Run Text=" cm³"/>
                                </TextBlock>

                                <TextBlock Text="Percentual de alerta"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"/>

                                <TextBlock FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"
                                           Margin="0,5,0,20">
                                    <Run Text="{Binding PercentualAlerta}"/>
                                    <Run Text=" %"/>
                                </TextBlock>

                                <Separator Margin="0,10,0,20"/>

                                <TextBlock Text="Status do Cadastro"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"
                                           Margin="0,0,0,8"/>

                                <TextBlock Text="Os dados preenchidos serão utilizados para cálculo de ocupação, espaço livre e percentual de alerta durante o mapeamento."
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Foreground="#64748B"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Border>

            </TabItem>

            <!-- ========================================== -->
            <!-- ABA 3: HISTÓRICO -->
            <!-- ========================================== -->

            <TabItem Header="Histórico de Medições">

                <Border Margin="0,20,0,0"
                        Background="White"
                        CornerRadius="15"
                        Padding="25"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- TÍTULO DO HISTÓRICO -->

                        <StackPanel Grid.Row="0"
                                    Margin="0,0,0,20">

                            <TextBlock Text="Histórico de Medições"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>

                            <TextBlock Text="Últimas medições registradas no banco SQLite."
                                       FontSize="15"
                                       Foreground="#64748B"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                        <!-- TABELA DE HISTÓRICO -->

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding HistoricoMedicoes}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Background="White"
                                  BorderBrush="#E5E7EB"
                                  BorderThickness="1"
                                  RowHeight="35"
                                  FontSize="14">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding Id}"
                                                    Width="70"/>

                                <DataGridTextColumn Header="Volume"
                                                    Binding="{Binding VolumeCm3, StringFormat={}{0:F0} cm³}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Data/Hora"
                                                    Binding="{Binding DataHora, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                                                    Width="180"/>

                                <DataGridTextColumn Header="Kinect Ligado"
                                                    Binding="{Binding KinectLigado}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Calibrado"
                                                    Binding="{Binding Calibrado}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding Status}"
                                                    Width="*"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

            </TabItem>

        </TabControl>

    </Grid>

</Window>