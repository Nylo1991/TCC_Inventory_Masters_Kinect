<Window x:Class="TCC_Inventory_Masters_Kinect.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Masters"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F7">

    <Window.Resources>

        <!-- ========================================== -->
        <!-- ESTILOS GERAIS -->
        <!-- ========================================== -->

        <Style x:Key="TituloPrincipal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
        </Style>

        <Style x:Key="Subtitulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>

        <Style x:Key="TituloCard" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <Style x:Key="TextoInfo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CardSecundario" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- BOTÕES MENORES -->

        <Style x:Key="BotaoPrimario" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="BotaoSucesso" TargetType="Button" BasedOn="{StaticResource BotaoPrimario}">
            <Setter Property="Background" Value="#0F766E"/>
        </Style>

        <Style x:Key="BotaoPerigo" TargetType="Button" BasedOn="{StaticResource BotaoPrimario}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>

        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="Margin" Value="0,6,0,18"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Window.Resources>

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- CABEÇALHO -->
        <!-- ========================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Inventory Masters"
                           Style="{StaticResource TituloPrincipal}"/>

                <TextBlock Text="Mapeamento Inteligente de Espaços com Kinect"
                           Style="{StaticResource Subtitulo}"
                           Margin="0,4,0,0"/>

            </StackPanel>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="14"
                    Padding="16,10"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    VerticalAlignment="Center">

                <TextBlock Text="Sistema Kinect"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#334155"/>

            </Border>

        </Grid>

        <!-- ========================================== -->
        <!-- ABAS PRINCIPAIS -->
        <!-- ========================================== -->

        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="14">

            <!-- ========================================== -->
            <!-- ABA 1: KINECT / MAPEAMENTO -->
            <!-- ========================================== -->

            <TabItem Header="Kinect / Mapeamento">

                <Grid Margin="0,20,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="2.4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ========================================== -->
                    <!-- PAINEL ESQUERDO COM SCROLL -->
                    <!-- ========================================== -->

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource Card}"
                            Margin="0,0,18,0"
                            Padding="18">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <StackPanel>

                                <!-- CARD CONTROLES -->

                                <Border Style="{StaticResource CardSecundario}"
                                        Margin="0,0,0,14">

                                    <StackPanel>

                                        <TextBlock Text="Controle do Kinect"
                                                   Style="{StaticResource TituloCard}"/>

                                        <TextBlock Text="Inicie a câmera, calibre o chão e acompanhe o mapeamento em tempo real."
                                                   Style="{StaticResource TextoInfo}"
                                                   Margin="0,0,0,14"/>

                                        <Button Content="▶ Iniciar Mapeamento"
                                                Style="{StaticResource BotaoPrimario}"
                                                Command="{Binding LigarKinectCommand}"/>

                                        <Button Content="▣ Calibrar Chão"
                                                Style="{StaticResource BotaoSucesso}"
                                                Command="{Binding CalibrarCommand}"/>

                                        <Button Content="■ Desligar Kinect"
                                                Style="{StaticResource BotaoPerigo}"
                                                Command="{Binding DesligarKinectCommand}"/>

                                    </StackPanel>

                                </Border>

                                <!-- CARD STATUS DE CONEXÃO -->

                                <Border Style="{StaticResource CardSecundario}"
                                        Margin="0,0,0,14">

                                    <StackPanel>

                                        <TextBlock Text="Status de Conexão"
                                                   Style="{StaticResource TituloCard}"/>

                                        <Border Background="White"
                                                CornerRadius="10"
                                                Padding="12"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1"
                                                Margin="0,0,0,8">

                                            <TextBlock Text="{Binding StatusKinect}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1E293B"/>

                                        </Border>

                                        <Border Background="White"
                                                CornerRadius="10"
                                                Padding="12"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1"
                                                Margin="0,0,0,8">

                                            <TextBlock Text="{Binding StatusSQLite}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1E293B"/>

                                        </Border>

                                        <Border Background="White"
                                                CornerRadius="10"
                                                Padding="12"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1"
                                                Margin="0,0,0,8">

                                            <TextBlock Text="{Binding StatusSignalR}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1E293B"/>

                                        </Border>

                                        <Border Background="White"
                                                CornerRadius="10"
                                                Padding="12"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1">

                                            <TextBlock Text="{Binding StatusMvcFirebase}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1E293B"/>

                                        </Border>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </ScrollViewer>

                    </Border>

                    <!-- ========================================== -->
                    <!-- ÁREA DA CÂMERA -->
                    <!-- ========================================== -->

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource Card}"
                            Padding="18">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,14">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock Text="Visualização Kinect"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#1E293B"/>

                                    <TextBlock Text="Imagem RGB capturada em tempo real"
                                               FontSize="14"
                                               Foreground="#64748B"
                                               Margin="0,3,0,0"/>

                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="#EEF2FF"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="{Binding StatusKinect}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#3730A3"/>

                                </Border>

                            </Grid>

                            <Border Grid.Row="1"
                                    Background="#F8FAFC"
                                    CornerRadius="16"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1">

                                <Grid>

                                    <Image Source="{Binding CameraImage}"
                                           Stretch="Uniform"
                                           Margin="16"/>

                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                IsHitTestVisible="False">

                                        <TextBlock Text="Área de Mapeamento"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="#4F46E5"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Text="A câmera Kinect aparecerá aqui após iniciar o mapeamento."
                                                   Margin="0,15,0,0"
                                                   FontSize="16"
                                                   TextAlignment="Center"
                                                   Foreground="#64748B"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </Grid>

                    </Border>

                    <!-- ========================================== -->
                    <!-- CARDS DE INFORMAÇÕES CAPTURADAS -->
                    <!-- ========================================== -->

                    <Grid Grid.Row="1"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="0,18,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.3*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource Card}"
                                Margin="0,0,10,0">

                            <StackPanel>

                                <TextBlock Text="Volume Atual"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"/>

                                <TextBlock Text="{Binding VolumeTexto}"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="#4F46E5"
                                           Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource Card}"
                                Margin="0,0,10,0">

                            <StackPanel>

                                <TextBlock Text="Point Cloud"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"/>

                                <TextBlock Text="{Binding QuantidadePontos3D}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"
                                           Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource Card}"
                                Margin="0,0,10,0">

                            <StackPanel>

                                <TextBlock Text="Ocupação"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"/>

                                <TextBlock Text="{Binding PercentualOcupacaoTexto}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"
                                           Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="3"
                                Style="{StaticResource Card}"
                                Margin="0,0,10,0">

                            <StackPanel>

                                <TextBlock Text="Espaço Livre"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"/>

                                <TextBlock Text="{Binding EspacoLivreTexto}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"
                                           Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="4"
                                Style="{StaticResource Card}">

                            <StackPanel>

                                <TextBlock Text="Mensagem do Sistema"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"/>

                                <TextBlock Text="{Binding Status}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#1E293B"
                                           Margin="0,8,0,0"/>

                                <TextBlock Text="{Binding UltimoSnapshot}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="#64748B"
                                           Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Grid>

            </TabItem>

            <!-- ========================================== -->
            <!-- ABA 2: CADASTRO DO ESPAÇO -->
            <!-- ========================================== -->

            <TabItem Header="Cadastro do Espaço">

                <Grid Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource Card}"
                            Margin="0,0,18,0">

                        <StackPanel>

                            <TextBlock Text="Cadastro do Espaço"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>

                            <TextBlock Text="Preencha os dados do espaço que será monitorado pelo Kinect."
                                       FontSize="16"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,30"/>

                            <TextBlock Text="Nome do Espaço"
                                       Style="{StaticResource Rotulo}"/>

                            <TextBox Style="{StaticResource CampoTexto}"
                                     Text="{Binding NomeEspaco, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Volume Máximo Permitido (cm³)"
                                       Style="{StaticResource Rotulo}"/>

                            <TextBox Style="{StaticResource CampoTexto}"
                                     Text="{Binding VolumeMaximo, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Percentual de Alerta (%)"
                                       Style="{StaticResource Rotulo}"/>

                            <TextBox Style="{StaticResource CampoTexto}"
                                     Text="{Binding PercentualAlerta, UpdateSourceTrigger=PropertyChanged}"/>

                            <Border Background="#EEF2FF"
                                    CornerRadius="14"
                                    Padding="16"
                                    BorderBrush="#C7D2FE"
                                    BorderThickness="1"
                                    Margin="0,10,0,0">

                                <TextBlock Text="Após preencher os dados, volte para a aba Kinect / Mapeamento e clique em Iniciar Mapeamento. O espaço será associado à leitura atual."
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Foreground="#3730A3"/>

                            </Border>

                        </StackPanel>

                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource Card}">

                        <StackPanel>

                            <TextBlock Text="Resumo do Espaço"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"
                                       Margin="0,0,0,22"/>

                            <Border Style="{StaticResource CardSecundario}"
                                    Margin="0,0,0,12">

                                <StackPanel>

                                    <TextBlock Text="Nome cadastrado"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#64748B"/>

                                    <TextBlock Text="{Binding NomeEspaco}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#4F46E5"
                                               Margin="0,5,0,0"/>

                                </StackPanel>

                            </Border>

                            <Border Style="{StaticResource CardSecundario}"
                                    Margin="0,0,0,12">

                                <StackPanel>

                                    <TextBlock Text="Volume máximo"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#64748B"/>

                                    <TextBlock FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#1E293B"
                                               Margin="0,5,0,0">
                                        <Run Text="{Binding VolumeMaximo}"/>
                                        <Run Text=" cm³"/>
                                    </TextBlock>

                                </StackPanel>

                            </Border>

                            <Border Style="{StaticResource CardSecundario}"
                                    Margin="0,0,0,12">

                                <StackPanel>

                                    <TextBlock Text="Percentual de alerta"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#64748B"/>

                                    <TextBlock FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#1E293B"
                                               Margin="0,5,0,0">
                                        <Run Text="{Binding PercentualAlerta}"/>
                                        <Run Text=" %"/>
                                    </TextBlock>

                                </StackPanel>

                            </Border>

                            <Separator Margin="0,16,0,16"/>

                            <TextBlock Text="Finalidade"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Esses dados serão usados para calcular ocupação, espaço livre e limite de alerta durante o mapeamento."
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="#64748B"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </TabItem>

            <!-- ========================================== -->
            <!-- ABA 3: HISTÓRICO -->
            <!-- ========================================== -->

            <TabItem Header="Histórico de Medições">

                <Border Margin="0,20,0,0"
                        Style="{StaticResource Card}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,20">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Histórico de Medições"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"/>

                                <TextBlock Text="Últimas medições registradas no banco SQLite."
                                           FontSize="15"
                                           Foreground="#64748B"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="#EEF2FF"
                                    CornerRadius="12"
                                    Padding="14,8"
                                    VerticalAlignment="Center">

                                <TextBlock Text="SQLite"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#3730A3"/>

                            </Border>

                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding HistoricoMedicoes}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Background="White"
                                  BorderBrush="#E5E7EB"
                                  BorderThickness="1"
                                  RowHeight="38"
                                  FontSize="14">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding Id}"
                                                    Width="70"/>

                                <DataGridTextColumn Header="Volume"
                                                    Binding="{Binding VolumeCm3, StringFormat={}{0:F0} cm³}"
                                                    Width="130"/>

                                <DataGridTextColumn Header="Data/Hora"
                                                    Binding="{Binding DataHora, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                                                    Width="190"/>

                                <DataGridTextColumn Header="Kinect Ligado"
                                                    Binding="{Binding KinectLigado}"
                                                    Width="130"/>

                                <DataGridTextColumn Header="Calibrado"
                                                    Binding="{Binding Calibrado}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding Status}"
                                                    Width="*"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

            </TabItem>

        </TabControl>

    </Grid>

</Window>