<Window x:Class="TCC_Inventory_Masters_Kinect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TCC_Inventory_Masters_Kinect.ViewModel"
        mc:Ignorable="d"

        Title="Inventory Masters - Scanner Inteligente"
        Height="720"
        Width="1200"

        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"

        Background="#0A0A0A">

    <!-- ========================================= -->
    <!-- DATACONTEXT -->
    <!-- ========================================= -->

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- ========================================= -->
    <!-- GRID PRINCIPAL -->
    <!-- ========================================= -->

    <Grid>

        <Grid.ColumnDefinitions>

            <!-- CÂMERA -->
            <ColumnDefinition Width="3*"/>

            <!-- PAINEL -->
            <ColumnDefinition Width="2*"/>

        </Grid.ColumnDefinitions>

        <!-- ========================================= -->
        <!-- ÁREA DA CÂMERA -->
        <!-- ========================================= -->

        <Border Grid.Column="0"
                Margin="15"
                Background="#111111"
                CornerRadius="15"
                BorderBrush="#33FF66"
                BorderThickness="2">

            <Grid>

                <Grid.RowDefinitions>

                    <!-- CAMERA -->
                    <RowDefinition Height="*"/>

                    <!-- INFO -->
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- ========================================= -->
                <!-- IMAGEM -->
                <!-- ========================================= -->

                <Border Margin="10"
                        Background="#000000"
                        CornerRadius="10">

                    <Image Source="{Binding CameraImage}"
                           Stretch="Uniform"/>
                </Border>

                <!-- ========================================= -->
                <!-- INFORMAÇÕES -->
                <!-- ========================================= -->

                <StackPanel Grid.Row="1"
                            Margin="0,10,0,15"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Inventory Masters"
                               Foreground="#33FF66"
                               FontSize="32"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Scanner Inteligente de Volume com Kinect"
                               Foreground="White"
                               FontSize="18"
                               Margin="0,5,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ========================================= -->
        <!-- PAINEL LATERAL -->
        <!-- ========================================= -->

        <Border Grid.Column="1"
                Margin="15"
                Background="#1B1B1B"
                CornerRadius="15"
                BorderBrush="#33FF66"
                BorderThickness="2">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="25">

                    <!-- ========================================= -->
                    <!-- TÍTULO -->
                    <!-- ========================================= -->

                    <TextBlock Text="Painel de Controle"
                               Foreground="#33FF66"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,0,0,30"/>

                    <!-- ========================================= -->
                    <!-- BOTÃO LIGAR -->
                    <!-- ========================================= -->

                    <Button Content="Ligar Kinect"
                            Command="{Binding LigarKinectCommand}"
                            Height="55"
                            Margin="0,0,0,15"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Background="#33AA33"
                            Foreground="White"
                            BorderThickness="0">

                        <Button.Style>

                            <Style TargetType="Button">

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="10">

                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                            </Style>

                        </Button.Style>

                    </Button>

                    <!-- ========================================= -->
                    <!-- BOTÃO CALIBRAR -->
                    <!-- ========================================= -->

                    <Button Content="Calibrar Chão"
                            Command="{Binding CalibrarCommand}"
                            Height="55"
                            Margin="0,0,0,15"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Background="#228822"
                            Foreground="White"
                            BorderThickness="0">

                        <Button.Style>

                            <Style TargetType="Button">

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="10">

                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                            </Style>

                        </Button.Style>

                    </Button>

                    <!-- ========================================= -->
                    <!-- BOTÃO DESLIGAR -->
                    <!-- ========================================= -->

                    <Button Content="Desligar Kinect"
                            Command="{Binding DesligarKinectCommand}"
                            Height="55"
                            Margin="0,0,0,35"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Background="#AA3333"
                            Foreground="White"
                            BorderThickness="0">

                        <Button.Style>

                            <Style TargetType="Button">

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="10">

                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                            </Style>

                        </Button.Style>

                    </Button>

                    <!-- ========================================= -->
                    <!-- VOLUME -->
                    <!-- ========================================= -->

                    <Border Background="#111111"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,20">

                        <StackPanel>

                            <TextBlock Text="Volume Detectado"
                                       Foreground="#AAAAAA"
                                       FontSize="16"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="{Binding VolumeTexto}"
                                       Foreground="#33FF66"
                                       FontSize="34"
                                       FontWeight="Bold"/>

                        </StackPanel>

                    </Border>

                    <!-- ========================================= -->
                    <!-- STATUS -->
                    <!-- ========================================= -->

                    <Border Background="#111111"
                            CornerRadius="12"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="Status do Sistema"
                                       Foreground="#AAAAAA"
                                       FontSize="16"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="{Binding Status}"
                                       Foreground="White"
                                       FontSize="18"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <!-- ========================================= -->
                    <!-- RODAPÉ -->
                    <!-- ========================================= -->

                    <TextBlock Text="Inventory Masters © 2026"
                               Foreground="#666666"
                               FontSize="14"
                               Margin="0,30,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>