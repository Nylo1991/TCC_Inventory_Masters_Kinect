<Window x:Class="TCC_Inventory_Masters_Kinect.View.KinectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinect / Mapeamento"
        Height="650"
        Width="1050"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F7">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Kinect / Mapeamento"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#4F46E5"
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="16"
                    Padding="22"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="Controle do Kinect"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,16"/>

                    <Button Content="Iniciar Mapeamento"
                            Height="40"
                            Margin="0,0,0,10"
                            Command="{Binding LigarKinectCommand}"/>

                    <Button Content="Calibrar Chão"
                            Height="40"
                            Margin="0,0,0,10"
                            Command="{Binding CalibrarCommand}"/>

                    <Button Content="Desligar Kinect"
                            Height="40"
                            Command="{Binding DesligarKinectCommand}"/>

                    <TextBlock Text="{Binding StatusKinect}"
                               Margin="0,24,0,8"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding StatusSQLite}"
                               Margin="0,0,0,8"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding StatusSignalR}"
                               Margin="0,0,0,8"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding StatusMvcFirebase}"
                               FontWeight="SemiBold"/>

                </StackPanel>

            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="16"
                    Padding="22"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Margin="20,0,0,0">

                <Grid>

                    <Image Source="{Binding CameraImage}"
                           Stretch="Uniform"/>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">

                        <TextBlock Text="Área de Mapeamento"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#4F46E5"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="A câmera Kinect aparecerá aqui."
                                   FontSize="15"
                                   Foreground="#64748B"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

        <UniformGrid Grid.Row="2"
                     Columns="5"
                     Margin="0,20,0,0">

            <TextBlock Text="{Binding VolumeTexto}"
                       FontSize="18"
                       FontWeight="Bold"/>

            <TextBlock Text="{Binding QuantidadePontos3D}"
                       FontSize="16"
                       FontWeight="SemiBold"/>

            <TextBlock Text="{Binding PercentualOcupacaoTexto}"
                       FontSize="16"
                       FontWeight="SemiBold"/>

            <TextBlock Text="{Binding EspacoLivreTexto}"
                       FontSize="16"
                       FontWeight="SemiBold"/>

            <TextBlock Text="{Binding MensagemEnvioAplicacao}"
                       FontSize="14"
                       TextWrapping="Wrap"/>

        </UniformGrid>

    </Grid>
</Window>