<UserControl x:Class="TCC_Inventory_Masters_Kinect.View.KinectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PAINEL ESQUERDO -->

        <ScrollViewer Grid.Row="0"
                      Grid.Column="0"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- CONTROLE DO KINECT -->

                <Border Background="White"
                        CornerRadius="16"
                        Padding="24"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="Controle do Kinect"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,14"/>

                        <TextBlock Text="Inicie a câmera, calibre o chão e acompanhe o mapeamento em tempo real."
                                   FontSize="15"
                                   Foreground="#475569"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <Button Content="▶ Iniciar Mapeamento"
                                Height="38"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="White"
                                Background="#4F46E5"
                                Command="{Binding LigarKinectCommand}"
                                Margin="0,0,0,10"/>

                        <Button Content="▣ Calibrar Chão"
                                Height="38"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="White"
                                Background="#0F766E"
                                Command="{Binding CalibrarCommand}"
                                Margin="0,0,0,10"/>

                        <Button Content="■ Desligar Kinect"
                                Height="38"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="White"
                                Background="#DC2626"
                                Command="{Binding DesligarKinectCommand}"/>

                    </StackPanel>

                </Border>

                <!-- STATUS -->

                <Border Background="White"
                        CornerRadius="16"
                        Padding="24"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <StackPanel>

                        <TextBlock Text="Status de Conexão"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,16"/>

                        <Border Background="#F8FAFC"
                                CornerRadius="12"
                                Padding="14"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Margin="0,0,0,10">
                            <TextBlock Text="{Binding StatusKinect}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <Border Background="#F8FAFC"
                                CornerRadius="12"
                                Padding="14"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Margin="0,0,0,10">
                            <TextBlock Text="{Binding StatusSQLite}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <Border Background="#F8FAFC"
                                CornerRadius="12"
                                Padding="14"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Margin="0,0,0,10">
                            <TextBlock Text="{Binding StatusSignalR}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <Border Background="#F8FAFC"
                                CornerRadius="12"
                                Padding="14"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <TextBlock Text="{Binding StatusMvcFirebase}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                        </Border>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- VISUALIZAÇÃO KINECT -->

        <Border Grid.Row="0"
                Grid.Column="1"
                Background="White"
                CornerRadius="16"
                Padding="24"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Margin="20,0,0,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Vertical"
                            Margin="0,0,0,18">

                    <TextBlock Text="Visualização Kinect"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="Imagem RGB capturada em tempo real"
                               FontSize="15"
                               Foreground="#64748B"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="#F8FAFC"
                        CornerRadius="16"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <Grid>

                        <Image Source="{Binding CameraImage}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">

                            <TextBlock Text="Área de Mapeamento"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#4F46E5"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="A câmera Kinect aparecerá aqui após iniciar o mapeamento."
                                       FontSize="15"
                                       Foreground="#64748B"
                                       Margin="0,12,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

        </Border>

        <!-- CARDS INFERIORES -->

        <UniformGrid Grid.Row="1"
                     Grid.ColumnSpan="2"
                     Columns="5"
                     Margin="0,18,0,0">

            <Border Background="White"
                    CornerRadius="16"
                    Padding="20"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Margin="0,0,10,0">

                <StackPanel>
                    <TextBlock Text="Volume Atual"
                               FontSize="14"
                               Foreground="#64748B"/>
                    <TextBlock Text="{Binding VolumeTexto}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#4F46E5"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="16"
                    Padding="20"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Margin="0,0,10,0">

                <StackPanel>
                    <TextBlock Text="Point Cloud"
                               FontSize="14"
                               Foreground="#64748B"/>
                    <TextBlock Text="{Binding QuantidadePontos3D}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="16"
                    Padding="20"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Margin="0,0,10,0">

                <StackPanel>
                    <TextBlock Text="Ocupação"
                               FontSize="14"
                               Foreground="#64748B"/>
                    <TextBlock Text="{Binding PercentualOcupacaoTexto}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="16"
                    Padding="20"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Margin="0,0,10,0">

                <StackPanel>
                    <TextBlock Text="Espaço Livre"
                               FontSize="14"
                               Foreground="#64748B"/>
                    <TextBlock Text="{Binding EspacoLivreTexto}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="16"
                    Padding="20"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Mensagem do Sistema"
                               FontSize="14"
                               Foreground="#64748B"/>
                    <TextBlock Text="{Binding Status}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding UltimoSnapshot}"
                               FontSize="13"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

        </UniformGrid>

    </Grid>

</UserControl>