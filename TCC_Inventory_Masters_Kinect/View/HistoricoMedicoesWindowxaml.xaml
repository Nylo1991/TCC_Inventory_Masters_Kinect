<Window x:Class="TCC_Inventory_Masters_Kinect.View.HistoricoMedicoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title=" Histórico de Medições"
        Height="675"
        Width="980"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding IniciarHistoricoCommand}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Closed">
            <i:InvokeCommandAction Command="{Binding PararHistoricoCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#108A3B"
                Padding="24,0">
            <Grid>
                <TextBlock Text="Histórico de Medições"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Content="Fechar"
                        Width="90"
                        Height="34"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="White"
                        Foreground="#108A3B"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding FecharHistoricoCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Margin="22"
                Padding="18"
                BorderBrush="#DADDE2"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Medições Salvas"
                                   Foreground="#111111"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   ToolTip="Histórico de medições em tempo real."/>

                        <TextBlock Text="Dados salvos em tempo real"
                   Foreground="#6B7280"
                   FontSize="13"
                   Margin="0,4,0,0"
                   ToolTip="Dados Carregados automaticamente do banco de Dados."/>
                    </StackPanel>

                    <UniformGrid Grid.Row="1"
                 Columns="3"
                 Margin="0,14,0,0">
                        <Border BorderBrush="#16A34A"
                BorderThickness="2"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Empresa"
                           Foreground="#16A34A"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                                <TextBlock Text="{Binding EmpresaLogada}"
                           Foreground="#111111"
                           FontSize="18"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#2563EB"
                BorderThickness="2"
                CornerRadius="8"
                Padding="12"
                Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Espaço"
                           Foreground="#2563EB"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                                <TextBlock Text="{Binding NomeEspaco}"
                           Foreground="#111111"
                           FontSize="18"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#D97706"
                                BorderThickness="2"
                                       CornerRadius="8"
                                     Padding="12"
                                     Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Limite"
                                    Foreground="#D97706"
                                    FontSize="12"
                                       FontWeight="SemiBold"/>

                                <TextBlock Text="{Binding PercentualAlerta, StringFormat={}{0}%}"
                                         Foreground="#111111"
                                     FontSize="18"
                                     FontWeight="Bold"
                                         TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding HistoricoMedicoes}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#F4F6F8"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#DADDE2"
                          VerticalGridLinesBrush="Transparent"
                          HeadersVisibility="Column"
                          BorderBrush="#DADDE2"
                          BorderThickness="1"
                          FontSize="13"
                          RowHeight="34"
                          ColumnHeaderHeight="42"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ToolTip="Histórico de medições em tempo real.">
                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="10"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0B3323"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderBrush" Value="#0B3323"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                        Binding="{Binding Id}"
                        Width="0.6*"/>

                        <DataGridTextColumn Header="Volume (m3)"
                        Binding="{Binding VolumeM3, StringFormat={}{0:F3}}"
                        Width="*"/>

                        <DataGridTextColumn Header="Data/Hora"
                        Binding="{Binding DataHora, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                        Width="*"/>

                        <DataGridTextColumn Header="Kinect"
                        Binding="{Binding KinectTexto}"
                        Width="*"/>

                        <DataGridTextColumn Header="Calibrado"
                        Binding="{Binding CalibradoTexto}"
                        Width="*"/>

                        <DataGridTextColumn Header="Status"
                        Binding="{Binding Status}"
                        Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
