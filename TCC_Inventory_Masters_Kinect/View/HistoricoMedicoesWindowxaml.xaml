<Window x:Class="TCC_Inventory_Masters_Kinect.View.HistoricoMedicoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Histórico de Medições"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F7">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Histórico de Medições"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#4F46E5"
                   Margin="0,0,0,20"/>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding HistoricoMedicoes}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Background="White">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="80"/>

                <DataGridTextColumn Header="Volume"
                                    Binding="{Binding VolumeCm3}"
                                    Width="*"/>

                <DataGridTextColumn Header="Data/Hora"
                                    Binding="{Binding DataHora}"
                                    Width="220"/>

                <DataGridTextColumn Header="Kinect"
                                    Binding="{Binding KinectLigado}"
                                    Width="120"/>

                <DataGridTextColumn Header="Calibrado"
                                    Binding="{Binding Calibrado}"
                                    Width="120"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="180"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Window>