<Page x:Class="TCC_Inventory_Masters_Kinect.View.KinectVisualizer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helix="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
      Title="KinectVisualizer">

    <Grid>
        <helix:HelixViewport3D x:Name="viewPort" ZoomExtentsWhenLoaded="True" Background="White">
            <helix:DefaultLights />

            <helix:PointsVisual3D x:Name="pontosKinect" Size="2" Color="Blue" />

            <helix:DefaultLights/>
            <helix:CoordinateSystemVisual3D />
        </helix:HelixViewport3D>
    </Grid>
</Page>