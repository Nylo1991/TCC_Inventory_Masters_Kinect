<Window x:Class="TCC_Inventory_Masters_Kinect.View.CadastroEspacoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro do Espaço"
        Height="520"
        Width="620"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F7">

    <Border Background="White"
            CornerRadius="18"
            Padding="32"
            Margin="24"
            BorderBrush="#E5E7EB"
            BorderThickness="1">

        <StackPanel>

            <TextBlock Text="Cadastro do Espaço"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#4F46E5"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Nome do Espaço"/>
            <TextBox Height="40"
                     Margin="0,6,0,16"
                     Text="{Binding NomeEspaco, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Volume Máximo (cm³)"/>
            <TextBox Height="40"
                     Margin="0,6,0,16"
                     Text="{Binding VolumeMaximo, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Percentual de Alerta (%)"/>
            <TextBox Height="40"
                     Margin="0,6,0,16"
                     Text="{Binding PercentualAlerta, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Após preencher, abra a janela Kinect / Mapeamento e inicie o monitoramento."
                       Foreground="#64748B"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"/>

        </StackPanel>

    </Border>
</Window>