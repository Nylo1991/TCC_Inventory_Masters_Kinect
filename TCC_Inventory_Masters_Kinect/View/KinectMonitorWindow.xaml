<Window x:Class="TCC_Inventory_Masters_Kinect.View.KinectMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Masters - Kinect"
        Height="760"
        Width="1180"
        MinHeight="700"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Closing="KinectWindow_Closing"
        Background="#F4F6F8">

    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.RowSpan="3"
                Background="#0B3323">
            <StackPanel Margin="24,28">
                <TextBlock Text="Inventory"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"/>

                <TextBlock Text="Masters"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"
                           Margin="0,-6,0,0"/>

                <TextBlock Text="Gestao de Estoque Inteligente"
                           Foreground="#B7D6C8"
                           FontSize="14"
                           Margin="0,10,0,34"/>

                <TextBlock Text="Monitoramento Kinect"
                           Foreground="#B7D6C8"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,12"
                           ToolTip="Tela atual de captura RGB, calibracao e volume."/>

                <Button Content="Historico de Medicoes"
                     Background="Transparent"
                      Foreground="White"
                      BorderThickness="0"
                     FontSize="15"
                       HorizontalAlignment="Left"
                     Margin="0,12"
                     Padding="0"
                    Cursor="Hand"
                     Click="AbrirHistorico_Click"
                       ToolTip="Historico de medicoes em tempo real "/>
            </StackPanel>
        </Border>

        <Border Grid.Row="0"
        Grid.Column="1"
        Grid.ColumnSpan="2"
        Background="#108A3B"
        Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                   Text="Monitoramento Kinect"
                   Foreground="White"
                   FontSize="22"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="Captura em tempo real e medicao volumetrica pelo Kinect 360."/>

                <TextBlock Grid.Column="1"
                   Text="{Binding UsuarioLogado}"
                   Foreground="White"
                   FontSize="16"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding UsuarioLogado}"/>

                <Button Grid.Column="2"
                Content="Sair"
                Width="70"
                Height="32"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="red"
                Foreground="White"
                FontWeight="Bold"
                BorderThickness="0"
                Cursor="Hand"
                Click="SairButton_Click"
                ToolTip="Sair do sistema e fechar a aplicacao."/>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#DADDE2"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0"
                    Margin="0,0,0,14"
                    ClipToBounds="True">
                <Grid Background="#F4F6F8" ClipToBounds="True">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Panel.ZIndex="0">
                        <TextBlock Text="Camera RGB"
                                   Foreground="#111111"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Pressione Ligar Kinect para iniciar"
                                   Foreground="#6B7280"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Image Source="{Binding CameraImage}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Panel.ZIndex="1"
                           ToolTip="Imagem RGB em tempo real capturada pelo Kinect."/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                     Background="White"
                      BorderBrush="#DADDE2"
                       BorderThickness="1"
                       CornerRadius="8"
                         Padding="0"
        ClipToBounds="True">
                <Grid Background="#F4F6F8" ClipToBounds="True">
                    <StackPanel x:Name="CalibrationMessagePanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Panel.ZIndex="0">
                        <TextBlock x:Name="CalibrationTitleTextBlock"
                       Text="Video de Calibracao"
                       Foreground="#111111"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>

                        <TextBlock x:Name="CalibrationSubtitleTextBlock"
                       Text="O video inicia ao clicar em Calibrar"
                       Foreground="#6B7280"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
                    </StackPanel>

                    <MediaElement x:Name="CalibrationVideoElement"
                          Source="Videos/calibracao.mp4"
                          LoadedBehavior="Manual"
                           UnloadedBehavior="Stop"
                           Stretch="Uniform"
                            HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                             Visibility="Hidden"
                           MediaEnded="CalibrationVideoElement_MediaEnded"
                            Panel.ZIndex="1"
                              ToolTip="Video de orientacao exibido durante a calibracao."/>
                </Grid>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,22,22,22">
            <StackPanel>
                <Border Background="White"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12"
                        BorderBrush="#DADDE2"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Status do Sistema"
                                   Foreground="#111111"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Margin="0,0,0,12"
                                   ToolTip="Mostra o estado atual do Kinect, SQLite e SignalR."/>

                        <Border BorderBrush="#16A34A"
                                BorderThickness="2"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,8">
                            <TextBlock Text="{Binding StatusKinect}"
                                       Foreground="#16A34A"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       ToolTip="Estado de conexao do Kinect."/>
                        </Border>

                        <Border BorderBrush="#2563EB"
                                BorderThickness="2"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,8">
                            <TextBlock Text="{Binding StatusSQLite}"
                                       Foreground="#2563EB"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       ToolTip="Estado do salvamento local no SQLite."/>
                        </Border>

                        <Border BorderBrush="#D97706"
                                BorderThickness="2"
                                CornerRadius="8"
                                Padding="10">
                            <TextBlock Text="{Binding StatusSignalR}"
                                       Foreground="#D97706"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       ToolTip="Estado da comunicacao com o MVC via SignalR."/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="White"
        CornerRadius="8"
        Padding="16"
        Margin="0,0,0,12"
        BorderBrush="#DADDE2"
        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Medicao de Volume"
                   Foreground="#111111"
                   FontWeight="Bold"
                   FontSize="16"
                   Margin="0,0,0,12"
                   ToolTip="Resumo da ocupacao volumetrica calculada pelo Kinect."/>

                        <Border BorderBrush="#2563EB"
                BorderThickness="2"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Volume atual"
                           Foreground="#2563EB"
                           FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           ToolTip="Volume atualmente ocupado no espaco monitorado."/>

                                <TextBlock Text="{Binding VolumeTexto}"
                           Foreground="#111111"
                           FontSize="30"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="Volume atual detectado pelo Kinect em metros cubicos."/>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Rows="2">
                            <Border BorderBrush="#D97706"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,6,6">
                                <StackPanel>
                                    <TextBlock Text="Ocupacao"
                               Foreground="#D97706"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               ToolTip="Percentual ocupado em relacao ao volume maximo calibrado."/>

                                    <TextBlock Text="{Binding PercentualOcupacaoTexto}"
                               Foreground="#111111"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#16A34A"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="10"
                    Margin="6,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="Livre"
                               Foreground="#16A34A"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               ToolTip="Volume livre estimado no espaco calibrado."/>

                                    <TextBlock Text="{Binding EspacoLivreTexto}"
                               Foreground="#111111"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#2563EB"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,6,6,0">
                                <StackPanel>
                                    <TextBlock Text="Pontos"
                               Foreground="#2563EB"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               ToolTip="Quantidade de pontos de profundidade usados na calibracao."/>

                                    <TextBlock Text="{Binding QuantidadePontosDepth}"
                               Foreground="#111111"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#DC2626"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="10"
                    Margin="6,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Alerta"
                               Foreground="#DC2626"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               ToolTip="Indica se a ocupacao atingiu o limite informado no cadastro do espaco."/>

                                    <TextBlock Text="{Binding StatusAlertaTexto}"
                               Foreground="#111111"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12"
                        BorderBrush="#DADDE2"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Cadastro do Espaco"
                                   Foreground="#111111"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Margin="0,0,0,12"
                                   ToolTip="Identificacao do local usada no historico de medicoes."/>

                        <TextBlock Text="Nome do Espaco"
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"
                                   ToolTip="Nome usado para identificar o local monitorado."/>

                        <TextBox Text="{Binding NomeEspaco, UpdateSourceTrigger=PropertyChanged}"
                                 Background="White"
                                 Foreground="#111111"
                                 BorderBrush="#DADDE2"
                                 BorderThickness="1"
                                 Padding="10,6"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Limite de Ocupacao (%)"
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"
                                   ToolTip="Percentual usado para alerta de ocupacao."/>

                        <TextBox Text="{Binding PercentualAlerta, UpdateSourceTrigger=PropertyChanged}"
                                 Background="White"
                                 Foreground="#111111"
                                 BorderBrush="#DADDE2"
                                 BorderThickness="1"
                                 Padding="10,6"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Volume Maximo (m3)"
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"
                                   ToolTip="Volume de referencia criado na calibracao."/>

                        <TextBox Text="{Binding VolumeMaximo, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#F4F6F8"
                                 Foreground="#111111"
                                 BorderBrush="#DADDE2"
                                 BorderThickness="1"
                                 Padding="10,6"
                                 IsReadOnly="True"
                                 ToolTip="Volume maximo calculado na calibracao do espaco."/>
                        <TextBlock Text="{Binding MensagemEspaco}"
                                Foreground="#16A34A"
                                FontSize="12"
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"/>

                        <Button Content="Salvar Espaco"
                                Command="{Binding SalvarEspacoCommand}"
                                Background="#16A34A"
                                Foreground="White"
                                FontWeight="Bold"
                                 Padding="10,8"
                                 Margin="0,12,0,0"
                                 BorderThickness="0"
                                   Cursor="Hand"
                                 ToolTip="Salva os dados do espaco e libera o historico de medicoes."/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12"
                        BorderBrush="#DADDE2"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Controles"
                                   Foreground="#111111"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Margin="0,0,0,12"/>

                        <Button Content="Ligar Kinect"
                                Command="{Binding LigarKinectCommand}"
                                Background="#16A34A"
                                Foreground="White"
                                FontWeight="Bold"
                                Padding="10,8"
                                Margin="0,0,0,8"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Inicia a camera RGB, profundidade e conexao com o MVC."/>

                        <Button Content="Calibrar Espaco"
                                Command="{Binding CalibrarCommand}"
                                Click="CalibrarButton_Click"
                                Background="#D97706"
                                Foreground="White"
                                FontWeight="Bold"
                                Padding="10,8"
                                Margin="0,0,0,8"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Captura o espaco vazio como referencia do volume maximo."/>

                        <Button Content="Enviar Volume Atual"
                                Command="{Binding MedirCommand}"
                                Background="#2563EB"
                                Foreground="White"
                                FontWeight="Bold"
                                Padding="10,8"
                                Margin="0,0,0,8"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Calcula o volume atual usando o mapa de profundidade calibrado."/>

                        <Button Content="Desligar Kinect"
                                Command="{Binding DesligarKinectCommand}"
                                Background="#DC2626"
                                Foreground="White"
                                FontWeight="Bold"
                                Padding="10,8"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Encerra a captura do Kinect e para os timers."/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12"
                        BorderBrush="#DADDE2"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Envio de Dados em Tempo Real"
                                   Foreground="#111111"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Margin="0,0,0,12"
                                   ToolTip="Mostra se o volume foi enviado ao MVC."/>

                        <TextBlock Text="{Binding MensagemEnvioAplicacao}"
                                   Foreground="#6B7280"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   ToolTip="Resultado da ultima tentativa de envio via SignalR."/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="8"
                        Padding="16"
                        BorderBrush="#DADDE2"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Status Geral do Sistema"
                                   Foreground="#111111"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Margin="0,0,0,12"
                                   ToolTip="Resumo da ultima acao executada."/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#6B7280"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   ToolTip="Mensagem atual do sistema."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Background="#0B3323"
                Padding="16,8">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#B7D6C8"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="Status atual do monitoramento Kinect."/>
        </Border>
    </Grid>
</Window>