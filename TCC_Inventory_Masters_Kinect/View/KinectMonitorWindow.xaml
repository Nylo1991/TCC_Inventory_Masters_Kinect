<Window x:Class="TCC_Inventory_Masters_Kinect.View.KinectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinect - Mapeamento" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Closing="KinectWindow_Closing">

    <Grid Background="#1E1E2E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="#181825" Padding="16,10">
            <TextBlock Text="Kinect - Mapeamento e Volume"
                       Foreground="White" FontSize="18"
                       FontWeight="Bold"/>
        </Border>

        <!-- CÂMERA + VISUALIZADOR 3D -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Camera -->
            <Border Grid.Row="0" Background="#11111B"
                    BorderBrush="#45475A" BorderThickness="1"
                    Margin="0,0,0,5">
                <Grid>
                    <TextBlock Text="Camera RGB" Foreground="#6C7086"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="13"/>
                    <Image x:Name="CameraImageControl"
                           Source="{Binding CameraImage}"
                           Stretch="Uniform"/>
                </Grid>
            </Border>

            <!-- Visualizador 3D -->
            <Border Grid.Row="1" Background="#11111B"
                    BorderBrush="#45475A" BorderThickness="1"
                    Margin="0,5,0,0">
                <Grid>
                    <TextBlock Text="Visualizacao 3D - Nuvem de Pontos"
                               Foreground="#6C7086"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="13"/>
                    <Frame x:Name="VisualizadorFrame" NavigationUIVisibility="Hidden"/>
                </Grid>
            </Border>
        </Grid>

        <!-- PAINEL DIREITO -->
        <ScrollViewer Grid.Row="1" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,10,10,10">
            <StackPanel>

                <!-- STATUS KINECT -->
                <Border Background="#181825" CornerRadius="6"
                        Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Status do Sistema"
                                   Foreground="#CDD6F4"
                                   FontWeight="Bold" FontSize="13"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding StatusKinect}"
                                   Foreground="#A6E3A1" FontSize="12"
                                   Margin="0,2"/>
                        <TextBlock Text="{Binding StatusSQLite}"
                                   Foreground="#89DCEB" FontSize="12"
                                   Margin="0,2"/>
                        <TextBlock Text="{Binding StatusSignalR}"
                                   Foreground="#F9E2AF" FontSize="12"
                                   Margin="0,2"/>
                        <TextBlock Text="{Binding StatusMvcFirebase}"
                                   Foreground="#CBA6F7" FontSize="12"
                                   Margin="0,2"/>
                    </StackPanel>
                </Border>

                <!-- DADOS DE VOLUME -->
                <Border Background="#181825" CornerRadius="6"
                        Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Medicao de Volume"
                                   Foreground="#CDD6F4"
                                   FontWeight="Bold" FontSize="13"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding VolumeTexto}"
                                   Foreground="White" FontSize="14"
                                   FontWeight="Bold" Margin="0,2"/>
                        <TextBlock Text="{Binding PercentualOcupacaoTexto}"
                                   Foreground="#F9E2AF" FontSize="13"
                                   Margin="0,2"/>
                        <TextBlock Text="{Binding EspacoLivreTexto}"
                                   Foreground="#A6E3A1" FontSize="12"
                                   Margin="0,2"/>
                        <TextBlock Text="{Binding QuantidadePontos3D}"
                                   Foreground="#89DCEB" FontSize="12"
                                   Margin="0,2"/>
                        <TextBlock Text="{Binding UltimoSnapshot}"
                                   Foreground="#6C7086" FontSize="11"
                                   Margin="0,2"/>
                    </StackPanel>
                </Border>

                <!-- CONFIGURAÇÃO DO ESPAÇO -->
                <Border Background="#181825" CornerRadius="6"
                        Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Configuracao do Espaco"
                                   Foreground="#CDD6F4"
                                   FontWeight="Bold" FontSize="13"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Nome do Espaco"
                                   Foreground="#6C7086" FontSize="11"
                                   Margin="0,0,0,3"/>
                        <TextBox Text="{Binding NomeEspaco, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#313244" Foreground="White"
                                 BorderBrush="#45475A" Padding="6,4"
                                 Margin="0,0,0,8"/>

                        <TextBlock Text="Limite de Ocupacao (%)"
                                   Foreground="#6C7086" FontSize="11"
                                   Margin="0,0,0,3"/>
                        <TextBox Text="{Binding PercentualAlerta, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#313244" Foreground="White"
                                 BorderBrush="#45475A" Padding="6,4"
                                 Margin="0,0,0,8"/>

                        <TextBlock Text="Volume Maximo (cm3)"
                                   Foreground="#6C7086" FontSize="11"
                                   Margin="0,0,0,3"/>
                        <TextBox Text="{Binding VolumeMaximo, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#313244" Foreground="White"
                                 BorderBrush="#45475A" Padding="6,4"
                                 Margin="0,0,0,4"
                                 IsReadOnly="False"/>
                        <TextBlock Text="Preenchido automaticamente apos calibrar o espaco"
                                   Foreground="#45475A" FontSize="10"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- BOTÕES DE CONTROLE -->
                <Border Background="#181825" CornerRadius="6"
                        Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Controles"
                                   Foreground="#CDD6F4"
                                   FontWeight="Bold" FontSize="13"
                                   Margin="0,0,0,8"/>

                        <Button Content="Ligar Kinect"
                                Command="{Binding LigarKinectCommand}"
                                Background="#A6E3A1" Foreground="#1E1E2E"
                                FontWeight="Bold" Padding="8,6"
                                Margin="0,0,0,6" Cursor="Hand"/>

                        <Button Content="Calibrar Chao"
                                Command="{Binding CalibrarCommand}"
                                Background="#89DCEB" Foreground="#1E1E2E"
                                FontWeight="Bold" Padding="8,6"
                                Margin="0,0,0,6" Cursor="Hand"/>

                        <Button Content="Calibrar Espaco (Volume Maximo)"
                                Command="{Binding CalibrarEspacoCommand}"
                                Background="#CBA6F7" Foreground="#1E1E2E"
                                FontWeight="Bold" Padding="8,6"
                                Margin="0,0,0,6" Cursor="Hand"/>

                        <Button Content="Desligar Kinect"
                                Command="{Binding DesligarKinectCommand}"
                                Background="#F38BA8" Foreground="#1E1E2E"
                                FontWeight="Bold" Padding="8,6"
                                Margin="0,0,0,0" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- STATUS DE ENVIO EXTERNO -->
                <Border Background="#181825" CornerRadius="6"
                        Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Envio Externo (MVC)"
                                   Foreground="#CDD6F4"
                                   FontWeight="Bold" FontSize="13"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding MensagemEnvioAplicacao}"
                                   Foreground="#A6ADC8" FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- STATUS GERAL -->
                <Border Background="#181825" CornerRadius="6"
                        Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Status Geral"
                                   Foreground="#CDD6F4"
                                   FontWeight="Bold" FontSize="13"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding Status}"
                                   Foreground="#A6ADC8" FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- RODAPÉ -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Background="#181825" Padding="16,8">
            <TextBlock Text="{Binding Status}"
                       Foreground="#6C7086" FontSize="11"/>
        </Border>

    </Grid>
</Window>
