<Window x:Class="TCC_Inventory_Masters_Kinect.View.KinectMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Masters - Kinect"
        Height="760"
        Width="1180"
        MinHeight="680"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Closing="KinectWindow_Closing"
        Background="#F4F6F8">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#DADDE2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.RowSpan="3"
                Background="#0B3323">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="24,30,24,20">
                    <TextBlock Text="Inventory"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock Text="Masters"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,-6,0,0"/>

                    <TextBlock Text="Gestao de Estoque Inteligente"
                               Foreground="#B7D6C8"
                               FontSize="14"
                               Margin="0,10,0,0"/>

                    <Border Background="#16A34A"
                            Height="4"
                            Width="118"
                            HorizontalAlignment="Left"
                            Margin="0,22,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="18,14,18,0">
                    <Border Background="#145A3D"
                            BorderBrush="#1E7A53"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,12"
                            Margin="0,0,0,10">
                        <TextBlock Text="Monitoramento Kinect"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <Button Content="Historico de Medicoes"
                            Height="42"
                            Background="Transparent"
                            Foreground="#D1FAE5"
                            BorderBrush="#1E7A53"
                            BorderThickness="1"
                            FontSize="15"
                            HorizontalContentAlignment="Left"
                            Padding="14,0"
                            Cursor="Hand"
                            Click="AbrirHistorico_Click"
                            ToolTip="Historico de medicoes em tempo real."/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="24,0,24,24">
                    <TextBlock Text="{Binding EmpresaLogada}"
                               Foreground="#D1FAE5"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding UsuarioLogado}"
                               Foreground="#B7D6C8"
                               FontSize="12"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="0"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Background="#108A3B"
                Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="88"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Monitoramento Kinect"
                           Foreground="White"
                           FontSize="23"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="Captura em tempo real e medicao volumetrica pelo Kinect 360."/>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,18,0">
                    <TextBlock Text="{Binding UsuarioLogado}"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               ToolTip="Usuario autenticado no sistema."/>

                    <TextBlock Text="{Binding EmpresaLogada}"
                               Foreground="#D1FAE5"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               ToolTip="Empresa vinculada ao acesso atual."/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Sair"
                        Width="72"
                        Height="36"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#DC2626"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SairButton_Click"
                        ToolTip="Sair do sistema e fechar a aplicacao."/>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="2.2*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0"
                    Margin="0,0,0,14"
                    ClipToBounds="True">
                <Grid Background="#F4F6F8" ClipToBounds="True">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Panel.ZIndex="0">
                        <TextBlock Text="Camera RGB"
                                   Foreground="#111111"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Pressione Ligar Kinect para iniciar"
                                   Foreground="#6B7280"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Image Source="{Binding CameraImage}"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Panel.ZIndex="1"
                           ToolTip="Imagem RGB em tempo real capturada pelo Kinect."/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0"
                    ClipToBounds="True">
                <Grid Background="#F4F6F8" ClipToBounds="True">
                    <StackPanel x:Name="CalibrationMessagePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Panel.ZIndex="0">
                        <TextBlock x:Name="CalibrationTitleTextBlock"
                                   Text="Video de Calibracao"
                                   Foreground="#111111"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="CalibrationSubtitleTextBlock"
                                   Text="O video inicia ao clicar em Calibrar"
                                   Foreground="#6B7280"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <MediaElement x:Name="CalibrationVideoElement"
                                  Source="Videos/calibracao.mp4"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Visibility="Hidden"
                                  MediaEnded="CalibrationVideoElement_MediaEnded"
                                  Panel.ZIndex="1"
                                  ToolTip="Video de orientacao exibido durante a calibracao."/>

                    <Border x:Name="PainelCalibracao"
                            Background="#AA000000"
                            Height="70"
                            VerticalAlignment="Top"
                            Visibility="Collapsed"
                            Panel.ZIndex="2">
                        <StackPanel Margin="15,8">
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding StatusCalibracao}"
                                       Foreground="#FFD966"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,22,22,22">
            <StackPanel>
                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Status"
                                   Foreground="#111111"
                                   FontWeight="Bold"
                                   FontSize="17"
                                   Margin="0,0,0,12"/>

                        <Border BorderBrush="#16A34A"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,8">
                            <TextBlock Text="{Binding StatusKinect}"
                                       Foreground="#16A34A"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       ToolTip="Estado de conexao do Kinect."/>
                        </Border>

                        <Border BorderBrush="#2563EB"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,8">
                            <TextBlock Text="{Binding StatusSQLite}"
                                       Foreground="#2563EB"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       ToolTip="Estado do salvamento local no SQLite."/>
                        </Border>

                        <Border BorderBrush="#D97706"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="10">
                            <TextBlock Text="{Binding StatusSignalR}"
                                       Foreground="#D97706"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       ToolTip="Estado da comunicacao com o MVC via SignalR."/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Medicao de Volume"
                                   Foreground="#111111"
                                   FontWeight="Bold"
                                   FontSize="17"
                                   Margin="0,0,0,12"/>

                        <Border BorderBrush="#2563EB"
                                BorderThickness="2"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Volume atual"
                                           Foreground="#2563EB"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding VolumeTexto}"
                                           Foreground="#111111"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="Volume atual detectado pelo Kinect em metros cubicos."/>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Rows="2">
                            <Border BorderBrush="#D97706"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,6,6">
                                <StackPanel>
                                    <TextBlock Text="Ocupacao"
                                               Foreground="#D97706"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding PercentualOcupacaoTexto}"
                                               Foreground="#111111"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#16A34A"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="6,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="Livre"
                                               Foreground="#16A34A"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding EspacoLivreTexto}"
                                               Foreground="#111111"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#2563EB"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,6,6,0">
                                <StackPanel>
                                    <TextBlock Text="Pontos"
                                               Foreground="#2563EB"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding QuantidadePontosDepth}"
                                               Foreground="#111111"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#DC2626"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="6,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Situacao"
                                               Foreground="#DC2626"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding StatusAlertaTexto}"
                                               Foreground="#111111"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Cadastro do Espaco"
                                   Foreground="#111111"
                                   FontWeight="Bold"
                                   FontSize="17"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Nome do Espaco"
                                   Style="{StaticResource LabelTextStyle}"/>

                        <TextBox Text="{Binding NomeEspaco, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"/>

                        <TextBlock Text="Limite de Ocupacao (%)"
                                   Style="{StaticResource LabelTextStyle}"/>

                        <TextBox Text="{Binding PercentualAlerta, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"/>

                        <TextBlock Text="Volume Maximo (m3)"
                                   Style="{StaticResource LabelTextStyle}"/>

                        <TextBox Text="{Binding VolumeMaximo, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Background="#F4F6F8"
                                 IsReadOnly="True"/>

                        <TextBlock Text="{Binding MensagemEspaco}"
                                   Foreground="#16A34A"
                                   FontSize="12"
                                   Margin="0,0,0,0"
                                   TextWrapping="Wrap"/>

                        <Button Content="Salvar Espaco"
                                Command="{Binding SalvarEspacoCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#16A34A"
                                Margin="0,12,0,0"
                                ToolTip="Salva os dados do espaco e libera o historico de medicoes."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Controles"
                                   Foreground="#111111"
                                   FontWeight="Bold"
                                   FontSize="17"
                                   Margin="0,0,0,12"/>

                        <Button Content="Ligar Kinect"
                                Command="{Binding LigarKinectCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#16A34A"
                                Margin="0,0,0,8"/>

                        <Button Content="Calibrar Espaco"
                                Command="{Binding CalibrarCommand}"
                                Click="CalibrarButton_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#D97706"
                                Margin="0,0,0,8"/>

                        <Button Content="Enviar Volume Atual"
                                Command="{Binding MedirCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#2563EB"
                                Margin="0,0,0,8"/>

                        <Button Content="Desligar Kinect"
                                Command="{Binding DesligarKinectCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#DC2626"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Envio em Tempo Real"
                                   Foreground="#111111"
                                   FontWeight="Bold"
                                   FontSize="17"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding MensagemEnvioAplicacao}"
                                   Foreground="#6B7280"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Status Geral"
                                   Foreground="#111111"
                                   FontWeight="Bold"
                                   FontSize="17"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#6B7280"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Background="#0B3323"
                Padding="16,8">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#B7D6C8"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>