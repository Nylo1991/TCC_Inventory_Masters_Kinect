<Window x:Class="TCC_Inventory_Masters_Kinect.View.KinectMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="Inventory Masters - Kinect"
        Height="760"
        Width="1180"
        MinHeight="680"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="PreviewMouseMove">
            <i:InvokeCommandAction Command="{Binding RegistrarAtividadeCommand}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="PreviewMouseDown">
            <i:InvokeCommandAction Command="{Binding RegistrarAtividadeCommand}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="PreviewKeyDown">
            <i:InvokeCommandAction Command="{Binding RegistrarAtividadeCommand}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Closed">
            <i:InvokeCommandAction Command="{Binding EncerrarCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#DADDE2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.RowSpan="3"
                Background="#0B3323">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="24,30,24,20">
                    <TextBlock Text="Inventory"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock Text="Masters"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,-6,0,0"/>

                    <TextBlock Text="Gestão de Estoque Inteligente"
                               Foreground="#B7D6C8"
                               FontSize="14"
                               Margin="0,10,0,0"/>

                    <Border Background="#16A34A"
                            Height="4"
                            Width="118"
                            HorizontalAlignment="Left"
                            Margin="0,22,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="18,14,18,0">
                    <Button Content="Histórico de Medições"
                            Height="44"
                            Background="#145A3D"
                            Foreground="White"
                            BorderBrush="#1E7A53"
                            BorderThickness="1"
                            FontSize="15"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="14,0"
                            Cursor="Hand"
                            Command="{Binding AbrirHistoricoCommand}"
                            ToolTip="Histórico de medições em tempo real."/>
                </StackPanel>

            </Grid>
        </Border>

        <Border Grid.Row="0"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Background="#108A3B"
                Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="88"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Monitoramento Kinect"
                           Foreground="White"
                           FontSize="23"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="Captura em tempo real e medição volumétrica pelo Kinect 360."/>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,18,0">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <TextBlock Text="Usuário: "
                                   Foreground="#D1FAE5"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding UsuarioLogado}"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,3,0,0">
                        <TextBlock Text="Empresa: "
                                   Foreground="#D1FAE5"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding EmpresaLogada}"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Sair"
                        Width="72"
                        Height="36"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#DC2626"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding SairCommand}"
                        ToolTip="Sair do sistema e fechar a aplicação."/>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="2.2*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0"
                    Margin="0,0,0,14"
                    ClipToBounds="True">
                <Grid Background="#F4F6F8" ClipToBounds="True">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Panel.ZIndex="0">
                        <TextBlock Text="Câmera RGB"
                                   Foreground="#111111"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Pressione Ligar Kinect para iniciar"
                                   Foreground="#6B7280"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Image Source="{Binding CameraImage}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Panel.ZIndex="1"
                           ToolTip="Imagem RGB em tempo real capturada pelo Kinect."/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0"
                    ClipToBounds="True">
                <Grid Background="#F4F6F8" ClipToBounds="True">
                    <StackPanel x:Name="CalibrationMessagePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Panel.ZIndex="0">
                        <TextBlock Text="{Binding CalibrationTitle}"
                                   Foreground="#111111"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="{Binding CalibrationSubtitle}"
                                   Foreground="#6B7280"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <MediaElement Source="Videos/calibracao.mp4"
                                  UnloadedBehavior="Stop"
                                  Stretch="UniformToFill"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Panel.ZIndex="1"
                                  ToolTip="Video de orientação exibido durante a calibração.">
                        <MediaElement.Style>
                            <Style TargetType="MediaElement">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="LoadedBehavior" Value="Stop"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CalibrationVideoPlaying}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="LoadedBehavior" Value="Play"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MediaElement.Style>
                    </MediaElement>

                    <Border
                            Background="#CC0B3323"
                            CornerRadius="8"
                            Padding="18"
                            Width="420"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding CalibrationVideoPlaying, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Panel.ZIndex="2">
                        <StackPanel>
                            <TextBlock Text="Calibração em andamento"
                                       Foreground="White"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="#D1FAE5"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="{Binding StatusCalibracao}"
                                       Foreground="#FFD966"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,22,22,22">
            <StackPanel>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Medição de Volume"
                                   Foreground="#111111"
                                   FontWeight="Bold"
                                   FontSize="17"
                                   Margin="0,0,0,12"/>

                        <Border BorderBrush="#2563EB"
                                BorderThickness="2"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Volume atual"
                                           Foreground="#2563EB"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding VolumeTexto}"
                                           Foreground="#111111"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="Volume atual detectado pelo Kinect em metros cubicos."/>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Rows="2">
                            <Border BorderBrush="#D97706"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="10"
                                    MinHeight="78"
                                    Margin="0,0,6,6">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ocupacao"
                                               Foreground="#D97706"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding PercentualOcupacaoTexto}"
                                               Foreground="#111111"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#16A34A"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="10"
                                    MinHeight="78"
                                    Margin="6,0,0,6">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Livre"
                                               Foreground="#16A34A"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding EspacoLivreTexto}"
                                               Foreground="#111111"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#2563EB"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="10"
                                    MinHeight="78"
                                    Margin="0,6,6,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Pontos"
                                               Foreground="#2563EB"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding QuantidadePontosDepth}"
                                               Foreground="#111111"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#DC2626"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="10"
                                    MinHeight="78"
                                    Margin="6,6,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Situacao"
                                               Foreground="#DC2626"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding StatusAlertaTexto}"
                                               Foreground="#111111"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Cadastro do Espaço"
                                   Foreground="#111111"
                                   FontWeight="Bold"
                                   FontSize="17"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Nome do Espaço"
                                   Style="{StaticResource LabelTextStyle}"/>

                        <TextBox Text="{Binding NomeEspaco, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"/>

                        <TextBlock Text="Limite de Ocupação (%)"
                                   Style="{StaticResource LabelTextStyle}"/>

                        <TextBox Text="{Binding PercentualAlerta, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"/>

                        <TextBlock Text="Volume Maximo (m3)"
                                   Style="{StaticResource LabelTextStyle}"/>

                        <TextBox Text="{Binding VolumeMaximo, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Background="#F4F6F8"
                                 IsReadOnly="True"/>

                        <TextBlock Text="{Binding MensagemEspaco}"
                                   Foreground="#16A34A"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>

                        <Button Content="Salvar Espaço"
                                Command="{Binding SalvarEspacoCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#16A34A"
                                Margin="0,12,0,0"
                                ToolTip="Salva os dados do espaço e libera o histórico de medições."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Controles"
                                   Foreground="#111111"
                                   FontWeight="Bold"
                                   FontSize="17"
                                   Margin="0,0,0,12"/>

                        <Button Content="Ligar Kinect"
                                Command="{Binding LigarKinectCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#16A34A"
                                Margin="0,0,0,8"/>

                        <Button Content="Calibrar Espaço"
                                Command="{Binding CalibrarCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#D97706"
                                Margin="0,0,0,8"/>

                        <Button Content="Enviar Volume Atual"
                                Command="{Binding MedirCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#2563EB"
                                Margin="0,0,0,8"/>

                        <Button Content="Desligar Kinect"
                                Command="{Binding DesligarKinectCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#DC2626"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Status do Sistema"
                                   Foreground="#111111"
                                   FontWeight="Bold"
                                   FontSize="17"
                                   Margin="0,0,0,12"/>

                        <Border BorderBrush="#16A34A"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,8">
                            <TextBlock Text="{Binding StatusKinect}"
                                       Foreground="#16A34A"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       ToolTip="Estado de conexão do Kinect."/>
                        </Border>

                        <Border BorderBrush="#2563EB"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,8">
                            <TextBlock Text="{Binding StatusSQLite}"
                                       Foreground="#2563EB"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       ToolTip="Estado do salvamento local no SQLite."/>
                        </Border>

                        <Border BorderBrush="#D97706"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="10">
                            <TextBlock Text="{Binding StatusSignalR}"
                                       Foreground="#D97706"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       ToolTip="Estado da comunicação com o MVC via SignalR."/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Envio em Tempo Real"
                                   Foreground="#111111"
                                   FontWeight="Bold"
                                   FontSize="17"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding MensagemEnvioAplicacao}"
                                   Foreground="#6B7280"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Status Geral"
                                   Foreground="#111111"
                                   FontWeight="Bold"
                                   FontSize="17"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#6B7280"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Background="#0B3323"
                Padding="16,8">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#B7D6C8"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <Grid
              Grid.Row="0"
              Grid.Column="0"
              Grid.RowSpan="3"
              Grid.ColumnSpan="3"
              Background="#DD0B3323"
              Visibility="{Binding SessaoBloqueada, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="99">

            <Border Width="430"
                    Background="White"
                    CornerRadius="8"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="#DADDE2"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Sessão bloqueada"
                               Foreground="#111111"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="O monitoramento do Kinect continua ativo."
                               Foreground="#6B7280"
                               FontSize="14"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,22"/>

                    <TextBlock Text="Usuário"
                               Foreground="#6B7280"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding UsuarioLogado}"
                               Foreground="#111111"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,4,0,14"/>

                    <TextBlock Text="Empresa"
                               Foreground="#6B7280"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding EmpresaLogada}"
                               Foreground="#111111"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,4,0,18"/>

                    <TextBlock Text="E-mail de recuperação"
                               Foreground="#6B7280"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding EmailSessao}"
                               Foreground="#111111"
                               FontSize="14"
                               Margin="0,4,0,12"/>

                    <Button Content="Enviar novo token"
                            Height="40"
                            Margin="0,0,0,16"
                            Background="White"
                            Foreground="#108A3B"
                            FontSize="14"
                            FontWeight="Bold"
                            BorderBrush="#108A3B"
                            BorderThickness="1"
                            Cursor="Hand"
                            IsEnabled="{Binding SolicitarNovoTokenHabilitado}"
                            Command="{Binding SolicitarNovoTokenCommand}"/>

                    <TextBlock Text="Token de desbloqueio"
                               Foreground="#111111"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox Height="42"
                             FontSize="15"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             TextAlignment="Center"
                             BorderBrush="#DADDE2"
                             BorderThickness="1"
                             MaxLength="6"
                             InputScope="Number"
                             Text="{Binding TokenDesbloqueio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{Binding MensagemBloqueio}"
                               Foreground="#DC2626"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>

                    <Button Content="Desbloquear"
                            Height="42"
                            Margin="0,22,0,0"
                            Background="#108A3B"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsDefault="True"
                            IsEnabled="{Binding DesbloquearHabilitado}"
                            Command="{Binding DesbloquearSessaoCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="0"
              Grid.Column="0"
              Grid.RowSpan="3"
              Grid.ColumnSpan="3"
              Background="#88000000"
              Visibility="{Binding AvisoHistoricoVisivel, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="100">
            <Border Width="460"
                    Height="250"
                    Padding="24"
                    Background="White"
                    BorderBrush="#DADDE2"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Histórico indisponível"
                               Foreground="#111111"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,0,0,14"/>

                    <TextBlock Grid.Row="1"
                               Text="Salve os dados do espaço antes de abrir o histórico de medições."
                               Foreground="#4B5563"
                               FontSize="16"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>

                    <Button Grid.Row="2"
                            Content="Entendi"
                            Width="110"
                            Height="38"
                            HorizontalAlignment="Right"
                            Background="#108A3B"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding FecharAvisoHistoricoCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
