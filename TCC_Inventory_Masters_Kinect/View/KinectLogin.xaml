<Window x:Class="TCC_Inventory_Masters_Kinect.View.KinectLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Masters"
        Width="1100"
        Height="685"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid Background="#F4F6F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0B3323">
            <StackPanel Margin="32" VerticalAlignment="Center">
                <TextBlock Text="Inventory" Foreground="White" FontSize="34" FontWeight="Bold"/>
                <TextBlock Text="Masters" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,-6,0,0"/>
                <TextBlock Text="Gestao de Estoque Inteligente" Foreground="#B7D6C8" FontSize="16" Margin="0,12,0,0"/>
                <Border Background="#108A3B" Height="4" Width="120" HorizontalAlignment="Left" Margin="0,28,0,0" CornerRadius="2"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Border Width="460"
                    Background="White"
                    CornerRadius="12"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="#DADDE2"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="TituloTextBlock"
                               Text="Acesso ao Kinect"
                               Foreground="#111111"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="SubtituloTextBlock"
                               Text="Entre ou cadastre um acesso"
                               Foreground="#6B7280"
                               FontSize="14"
                               Margin="0,8,0,24"
                               ToolTip="Para acessa o sistema e necessario entrar ou realizar um cadastro ."/>

                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="AbaEntrarButton"
                                Grid.Column="0"
                                Content="Entrar"
                                Height="40"
                                Background="#108A3B"
                                Foreground="White"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Click="AbaEntrar_Click"/>

                        <Button x:Name="AbaCadastroButton"
                                Grid.Column="1"
                                Content="Cadastro"
                                Height="40"
                                Background="#E5E7EB"
                                Foreground="#111111"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Click="AbaCadastro_Click"
                                ToolTip="Primeiro Acesso."/>

                    </Grid>

                    <StackPanel x:Name="LoginPanel">
                        <TextBlock Text="Usuario ou Email"
                                Foreground="#111111"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="LoginUsuarioTextBox"
                                 HorizontalContentAlignment="Center"

                                  Height="42"
                                    FontSize="15"
                                    Padding="12,0"
                                   BorderBrush="#DADDE2"
                                    BorderThickness="1"
                                   ToolTip="Digite seu usuario ou email cadastrado."/>

                        <TextBlock Text="Senha" 
                                   Foreground="#111111" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Margin="0,16,0,6"/>

                        <PasswordBox x:Name="LoginSenhaPasswordBox" 
                                     Height="42" 
                                     FontSize="15" 
                                     Padding="12,0" 
                                     BorderBrush="#DADDE2" 
                                     BorderThickness="1" 
                                     ToolTip="Digite sua senha cadastrada."/>

                        <TextBlock Text="Minimo de 6 caracteres."
                          Foreground="#6B7280"
                          FontSize="12"
                          Margin="0,6,0,0"/>

                        <Button Content="Entrar"
                                Height="44"
                                Margin="0,24,0,0"
                                Background="#108A3B"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Click="Entrar_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="CadastroPanel"
                                Visibility="Collapsed">
                        <TextBlock Text="Usuario" 
                                   Foreground="#111111" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="CadastroUsuarioTextBox" 
                           Height="42" 
                           FontSize="15" 
                           Padding="12,0" 
                           BorderBrush="#DADDE2" 
                            BorderThickness="1"
                          ToolTip="Digite o nome de usuario."/>

                        <TextBlock Text="Empresa" 
                           Foreground="#111111" 
                             FontSize="14"
                              FontWeight="SemiBold" 
                             Margin="0,16,0,6"/>

                        <TextBox x:Name="CadastroEmpresaTextBox" 
                             Height="42" 
                             FontSize="15" 
                              Padding="12,0" 
                             BorderBrush="#DADDE2" 
                              BorderThickness="1"
                               ToolTip="Digite o nome da empresa."/>

                        <TextBlock Text="Email" 
                          Foreground="#111111" 
                         FontSize="14"
                           FontWeight="SemiBold" 
                          Margin="0,16,0,6"/>

                        <TextBox x:Name="CadastroEmailTextBox" 
                             Height="42" 
                            FontSize="15" 
                           Padding="12,0" 
                            BorderBrush="#DADDE2" 
                             BorderThickness="1"
                             ToolTip="Digite Aqui Seu Email."/>

                        <TextBlock Text="Senha" 
                          Foreground="#111111" 
                            FontSize="14" 
                           FontWeight="SemiBold" 
                              Margin="0,16,0,6"/>

                        <PasswordBox x:Name="CadastroSenhaPasswordBox" 
                                   Height="42" 
                                  FontSize="15"
                                    Padding="12,0" 
                                  BorderBrush="#DADDE2" 
                                   BorderThickness="1"
                              ToolTip="Digite Aqui a Sua Senha."/>

                        <TextBlock Text="Confirmar senha" 
           Foreground="#111111" 
           FontSize="14" 
           FontWeight="SemiBold" 
           Margin="0,16,0,6"/>

                        <PasswordBox x:Name="CadastroConfirmarSenhaPasswordBox" 
             Height="42" 
             FontSize="15" 
             Padding="12,0" 
             BorderBrush="#DADDE2" 
             BorderThickness="1"
             ToolTip="Confirme Aqui a Sua Senha."/>
                        <Button Content="Cadastrar e entrar"
                                Height="44"
                                Margin="0,24,0,0"
                                Background="#108A3B"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Click="Cadastrar_Click"
                                ToolTip="Clicar para Finalizar o cadastro e ter acesso ao sistema"/>

                    </StackPanel>

                    <TextBlock x:Name="MensagemTextBlock"
                               Text=""
                               Foreground="#DC2626"
                               FontSize="13"
                               Margin="0,14,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>