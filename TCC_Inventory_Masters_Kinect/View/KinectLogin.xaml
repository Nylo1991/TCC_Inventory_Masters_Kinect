<Page x:Class="TCC_Inventory_Masters_Kinect.View.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="720"
      d:DesignWidth="1100"
      Title="Login">

    <Grid Background="#F4F6F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0B3323">
            <StackPanel Margin="32" VerticalAlignment="Center">
                <TextBlock Text="Inventory"
                           Foreground="White"
                           FontSize="34"
                           FontWeight="Bold"/>

                <TextBlock Text="Masters"
                           Foreground="White"
                           FontSize="34"
                           FontWeight="Bold"
                           Margin="0,-6,0,0"/>

                <TextBlock Text="Gestao de Estoque Inteligente"
                           Foreground="#B7D6C8"
                           FontSize="16"
                           Margin="0,12,0,0"/>

                <Border Background="#108A3B"
                        Height="4"
                        Width="120"
                        HorizontalAlignment="Left"
                        Margin="0,28,0,0"
                        CornerRadius="2"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Border Width="420"
                    Background="White"
                    CornerRadius="12"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="#DADDE2"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      Opacity="0.12"
                                      BlurRadius="18"
                                      ShadowDepth="3"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock x:Name="TituloTextBlock"
                               Text="Acesso ao Kinect"
                               Foreground="#111111"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="SubtituloTextBlock"
                               Text="Entre para iniciar o monitoramento volumetrico"
                               Foreground="#6B7280"
                               FontSize="14"
                               Margin="0,8,0,28"/>

                    <TextBlock Text="Usuario"
                               Foreground="#111111"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="UsuarioTextBox"
                             Height="42"
                             FontSize="15"
                             Padding="12,0"
                             BorderBrush="#DADDE2"
                             BorderThickness="1"/>

                    <TextBlock Text="Senha"
                               Foreground="#111111"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,18,0,6"/>

                    <PasswordBox x:Name="SenhaPasswordBox"
                                 Height="42"
                                 FontSize="15"
                                 Padding="12,0"
                                 BorderBrush="#DADDE2"
                                 BorderThickness="1"/>

                    <TextBlock x:Name="MensagemTextBlock"
                               Foreground="#DC2626"
                               FontSize="13"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"/>

                    <Button x:Name="EntrarButton"
                            Content="Entrar"
                            Height="44"
                            Margin="0,24,0,0"
                            Background="#108A3B"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="Entrar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>