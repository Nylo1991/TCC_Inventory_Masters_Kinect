<Window x:Class="TCC_Inventory_Masters_Kinect.View.KinectLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Masters"
        Width="1100"
        Height="685"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid Background="#F4F6F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0B3323">
            <StackPanel Margin="32" VerticalAlignment="Center">
                <TextBlock Text="Inventory"
                           Foreground="White"
                           FontSize="34"
                           FontWeight="Bold"/>

                <TextBlock Text="Masters"
                           Foreground="White"
                           FontSize="34"
                           FontWeight="Bold"
                           Margin="0,-6,0,0"/>

                <TextBlock Text="Gestao de Estoque Inteligente"
                           Foreground="#B7D6C8"
                           FontSize="16"
                           Margin="0,12,0,0"/>

                <Border Background="#108A3B"
                        Height="4"
                        Width="120"
                        HorizontalAlignment="Left"
                        Margin="0,28,0,0"
                        CornerRadius="2"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Border Width="460"
                    Background="White"
                    CornerRadius="12"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="#DADDE2"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock x:Name="TituloTextBlock"
                               Text="Acesso ao Kinect"
                               Foreground="#111111"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="SubtituloTextBlock"
                               Text="Entre ou cadastre um acesso"
                               Foreground="#6B7280"
                               FontSize="14"
                               Margin="0,8,0,24"/>

                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="AbaEntrarButton"
                                Grid.Column="0"
                                Content="Entrar"
                                Height="40"
                                Background="#108A3B"
                                Foreground="White"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="AbaEntrar_Click"/>

                        <Button x:Name="AbaCadastroButton"
                                Grid.Column="1"
                                Content="Cadastro"
                                Height="40"
                                Background="#E5E7EB"
                                Foreground="#111111"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="AbaCadastro_Click"
                                ToolTip="Primeiro acesso."/>
                    </Grid>

                    <StackPanel x:Name="LoginPanel">
                        <TextBlock Text="Usuario ou Email"
                                   Foreground="#111111"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="LoginUsuarioTextBox"
                                 Height="42"
                                 FontSize="15"
                                 Padding="10,0"
                                 HorizontalContentAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#DADDE2"
                                 BorderThickness="1"
                                 ToolTip="Digite seu usuario ou email cadastrado."/>

                        <TextBlock Text="Digite o usuario ou email usado no cadastro."
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   Margin="0,5,0,12"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Senha"
                                   Foreground="#111111"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <PasswordBox x:Name="LoginSenhaPasswordBox"
                                     Height="42"
                                     FontSize="15"
                                     Padding="10,0"
                                     HorizontalContentAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#DADDE2"
                                     BorderThickness="1"
                                     ToolTip="Digite sua senha cadastrada."/>

                        <TextBlock Text="Digite a senha cadastrada para acessar o sistema."
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>

                        <Button Content="Entrar"
                                Height="44"
                                Margin="0,24,0,0"
                                Background="#108A3B"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="Entrar_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="CadastroPanel"
                                Visibility="Collapsed">

                        <TextBlock Text="Usuario"
                                   Foreground="#111111"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="CadastroUsuarioTextBox"
                                 Height="42"
                                 FontSize="15"
                                 Padding="10,0"
                                 HorizontalContentAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#DADDE2"
                                 BorderThickness="1"
                                 ToolTip="Digite o nome de usuario."/>

                        <TextBlock Text="Informe o nome que sera usado para acessar o sistema."
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   Margin="0,5,0,12"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Empresa"
                                   Foreground="#111111"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="CadastroEmpresaTextBox"
                                 Height="42"
                                 FontSize="15"
                                 Padding="10,0"
                                 HorizontalContentAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#DADDE2"
                                 BorderThickness="1"
                                 ToolTip="Digite o nome da empresa."/>

                        <TextBlock Text="Informe a empresa vinculada ao acesso."
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   Margin="0,5,0,12"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Email"
                                   Foreground="#111111"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="CadastroEmailTextBox"
                                 Height="42"
                                 FontSize="15"
                                 Padding="10,0"
                                 HorizontalContentAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#DADDE2"
                                 BorderThickness="1"
                                 ToolTip="Digite seu email."/>

                        <TextBlock Text="Informe um email valido para identificar o acesso."
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   Margin="0,5,0,12"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Senha"
                                   Foreground="#111111"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <PasswordBox x:Name="CadastroSenhaPasswordBox"
                                     Height="42"
                                     FontSize="15"
                                     Padding="10,0"
                                     HorizontalContentAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#DADDE2"
                                     BorderThickness="1"
                                     ToolTip="Digite sua senha."/>

                        <TextBlock Text="A senha deve ter no minimo 6 caracteres e nao pode conter espacos."
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   Margin="0,5,0,12"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Confirmar senha"
                                   Foreground="#111111"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <PasswordBox x:Name="CadastroConfirmarSenhaPasswordBox"
                                     Height="42"
                                     FontSize="15"
                                     Padding="10,0"
                                     HorizontalContentAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#DADDE2"
                                     BorderThickness="1"
                                     ToolTip="Confirme sua senha."/>

                        <TextBlock Text="Repita a mesma senha informada acima."
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>

                        <Button Content="Cadastrar e entrar"
                                Height="44"
                                Margin="0,24,0,0"
                                Background="#108A3B"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="Cadastrar_Click"
                                ToolTip="Finalizar o cadastro e acessar o sistema."/>
                    </StackPanel>

                    <TextBlock x:Name="MensagemTextBlock"
                               Text=""
                               Foreground="#DC2626"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,14,0,0"
                               MinHeight="30"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>