<Window x:Class="TCC_Inventory_Masters_Kinect.View.KinectLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Masters"
        Width="1100"
        Height="678"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="#F4F6F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0B3323">
            <StackPanel Margin="32" VerticalAlignment="Center">
                <TextBlock Text="Inventory"
                           Foreground="White"
                           FontSize="34"
                           FontWeight="Bold"/>

                <TextBlock Text="Masters"
                           Foreground="White"
                           FontSize="34"
                           FontWeight="Bold"
                           Margin="0,-6,0,0"/>

                <TextBlock Text="Gestão de Estoque Inteligente"
                           Foreground="#B7D6C8"
                           FontSize="16"
                           Margin="0,12,0,0"/>

                <Border Background="#108A3B"
                        Height="4"
                        Width="120"
                        HorizontalAlignment="Left"
                        Margin="0,28,0,0"
                        CornerRadius="2"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Border Width="460"
                    Background="White"
                    CornerRadius="12"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="#DADDE2"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="{Binding Titulo}"
                               Foreground="#111111"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding Subtitulo}"
                               Foreground="#6B7280"
                               FontSize="14"
                               Margin="0,8,0,24"/>

                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Entrar"
                                Height="40"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding MostrarLoginCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#E5E7EB"/>
                                    <Setter Property="Foreground" Value="#111111"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AbaLoginSelecionada}" Value="True">
                                            <Setter Property="Background" Value="#108A3B"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="1"
                                Content="Token pelo MVC"
                                Height="40"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding MostrarSolicitacaoTokenCommand}"
                                ToolTip="Primeiro Acesso.">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#E5E7EB"/>
                                    <Setter Property="Foreground" Value="#111111"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AbaSolicitacaoSelecionada}" Value="True">
                                            <Setter Property="Background" Value="#108A3B"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <StackPanel Visibility="{Binding AbaLoginSelecionada, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Token de Acesso"
                                   Foreground="#111111"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <Grid>
                            <TextBox Height="42"
                                     FontSize="18"
                                     FontWeight="Bold"
                                     MaxLength="6"
                                     Padding="10,0"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#DADDE2"
                                     BorderThickness="1"
                                     Text="{Binding TokenAcesso, UpdateSourceTrigger=PropertyChanged}"
                                     InputScope="Number"
                                     ToolTip="Digite os seis números recebidos por e-mail."/>

                            <TextBlock Text="000000"
                                       Foreground="#6B7280"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding TokenVazio, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <TextBlock Text="Solicite o token no sistema MVC usando seu e-mail cadastrado."
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   Margin="0,5,0,12"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Senha"
                                   Visibility="Collapsed"
                                   Foreground="#111111"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <PasswordBox x:Name="LoginSenhaPasswordBox"
                                     Visibility="Collapsed"
                                     Height="42"
                                     FontSize="15"
                                     Padding="10,0"
                                     HorizontalContentAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#DADDE2"
                                     BorderThickness="1"
                                     ToolTip="Campo não utilizado no acesso por token."/>

                        <TextBlock Text="Digite a senha cadastrada para acessar o sistema."
                                   Visibility="Collapsed"
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>

                        <Button Content="Validar token e entrar"
                                Height="44"
                                Margin="0,24,0,0"
                                Background="#108A3B"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                IsDefault="True"
                                IsEnabled="{Binding PodeInteragir}"
                                Command="{Binding EntrarCommand}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding AbaSolicitacaoSelecionada, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <TextBlock Text="E-mail Cadastrado"
                                   Foreground="#111111"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <TextBox Height="42"
                                 FontSize="15"
                                 Padding="10,0"
                                 HorizontalContentAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#DADDE2"
                                 BorderThickness="1"
                                 Text="{Binding EmailCadastro, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Digite o e-mail Cadastrado no MVC."/>

                        <TextBlock Text="O MVC vai validar se o e-mail existe no cadastro de usuários e enviar um token temporário."
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>

                        <Button Content="Solicitar token ao MVC"
                                Height="44"
                                Margin="0,24,0,0"
                                Background="#108A3B"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                IsDefault="True"
                                IsEnabled="{Binding PodeInteragir}"
                                Command="{Binding SolicitarTokenCommand}"
                                ToolTip="Solicitar token para o e-mail cadastrado."/>
                    </StackPanel>

                    <TextBlock Text="{Binding Mensagem}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,14,0,0"
                               MinHeight="30"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#DC2626"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MensagemSucesso}" Value="True">
                                        <Setter Property="Foreground" Value="#108A3B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
