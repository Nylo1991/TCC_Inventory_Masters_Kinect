<UserControl x:Class="TCC_Inventory_Masters_Kinect.View.CadastroEspacoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <Border Background="White"
                CornerRadius="18"
                Padding="32"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                MaxWidth="520"
                HorizontalAlignment="Left">

            <StackPanel>

                <TextBlock Text="Cadastro do Espaço"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Informe os dados do espaço que será monitorado pelo Kinect."
                           FontSize="15"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           Margin="0,0,0,28"/>

                <TextBlock Text="Nome do Espaço"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#334155"/>

                <TextBox Height="42"
                         Margin="0,6,0,18"
                         FontSize="15"
                         Text="{Binding NomeEspaco, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Volume Máximo (cm³)"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#334155"/>

                <TextBox Height="42"
                         Margin="0,6,0,18"
                         FontSize="15"
                         Text="{Binding VolumeMaximo, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Percentual de Alerta (%)"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#334155"/>

                <TextBox Height="42"
                         Margin="0,6,0,28"
                         FontSize="15"
                         Text="{Binding PercentualAlerta, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Após cadastrar, volte para a página Kinect / Mapeamento e inicie o monitoramento."
                           FontSize="14"
                           Foreground="#64748B"
                           TextWrapping="Wrap"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>