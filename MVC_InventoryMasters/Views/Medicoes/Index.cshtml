@model List<MVC_InventoryMasters.Models.MedicaoVolume>

@{
    ViewData["Title"] = "Medições";

    int paginaAtual = ViewBag.PaginaAtual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;

    double volumeMedio = ViewBag.VolumeMedio ?? 0;
    DateTime? ultimaMedicao = ViewBag.UltimaMedicao;
}

<style>
    html, body {
        overflow-x: hidden !important;
    }

    .medicoes-page {
        width: 100%;
        max-width: calc(100vw - 260px);
        overflow-x: hidden !important;
    }

    .medicoes-title {
        font-size: 2rem;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .medicoes-kpis {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 22px;
        width: 100%;
    }

    .kpi-card {
        height: 70px !important;
        overflow: hidden;
    }

        .kpi-card .card-body {
            padding: 10px 14px !important;
        }

    .kpi-label {
        font-size: 0.78rem;
        color: #6c757d;
        line-height: 1;
        margin-bottom: 6px;
    }

    .kpi-value {
        font-size: 1.25rem;
        font-weight: 700;
        line-height: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .medicoes-card {
        width: 100%;
        max-width: 100%;
        overflow: hidden;
    }

    .medicoes-table {
        width: 100%;
        table-layout: fixed;
        margin-bottom: 0;
    }

        .medicoes-table th,
        .medicoes-table td {
            padding: 10px 12px !important;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 0.95rem;
        }

            .medicoes-table th:nth-child(1),
            .medicoes-table td:nth-child(1) {
                width: 22%;
            }

            .medicoes-table th:nth-child(2),
            .medicoes-table td:nth-child(2) {
                width: 22%;
            }

            .medicoes-table th:nth-child(3),
            .medicoes-table td:nth-child(3) {
                width: 18%;
                text-align: center;
            }

            .medicoes-table th:nth-child(4),
            .medicoes-table td:nth-child(4) {
                width: 38%;
            }

    .pagination {
        flex-wrap: wrap;
    }

    @@media (max-width: 992px) {
        .medicoes-page {
            max-width: 100%;
        }

        .medicoes-kpis {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container-fluid px-4 mt-4 medicoes-page">

    <h2 class="medicoes-title">Histórico de Medições</h2>

    <div class="medicoes-kpis">
        <div class="card shadow-sm border-primary border-2 kpi-card">
            <div class="card-body">
                <div class="kpi-label">Total de Medições</div>
                <div class="kpi-value">@totalRegistros</div>
            </div>
        </div>

        <div class="card shadow-sm border-success border-2 kpi-card">
            <div class="card-body">
                <div class="kpi-label">Volume Médio</div>
                <div class="kpi-value">@volumeMedio.ToString("N2") m³</div>
            </div>
        </div>

        <div class="card shadow-sm border-warning border-2 kpi-card">
            <div class="card-body">
                <div class="kpi-label">Última Medição</div>
                <div class="kpi-value">
                    @(ultimaMedicao.HasValue ? ultimaMedicao.Value.ToString("dd/MM/yyyy") : "-")
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 medicoes-card">
        <div class="card-header bg-white py-3">
            <strong>Lista de Medições</strong>
        </div>

        <div class="card-body p-0">
            <table class="table table-hover align-middle medicoes-table">
                <thead class="table-dark">
                    <tr>
                        <th>Volume (m³)</th>
                        <th>Origem</th>
                        <th>Status</th>
                        <th>Data</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">
                                    @(item.VolumeMedido?.ToString("N2") ?? "0,00")
                                </td>

                                <td>@item.OrigemLeitura</td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Status) && item.Status.ToLower() == "normal")
                                    {
                                        <span class="badge bg-success">Normal</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(item.Status) && item.Status.ToLower() == "alerta")
                                    {
                                        <span class="badge bg-warning text-dark">Alerta</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @(string.IsNullOrWhiteSpace(item.Status) ? "Sem Status" : item.Status)
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(item.DataHora.HasValue
                                        ? item.DataHora.Value.ToString("dd/MM/yyyy HH:mm:ss")
                                        : "-")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                Nenhuma medição encontrada.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small">
                    Total de registros: @totalRegistros
                </span>

                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(paginaAtual == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaAtual - 1)">&lt;</a>
                        </li>

                        @for (int i = 1; i <= totalPaginas; i++)
                        {
                            if (i == 1 || i == totalPaginas || (i >= paginaAtual - 2 && i <= paginaAtual + 2))
                            {
                                <li class="page-item @(i == paginaAtual ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-pagina="@i">@i</a>
                                </li>
                            }
                            else if (i == paginaAtual - 3 || i == paginaAtual + 3)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                        }

                        <li class="page-item @(paginaAtual == totalPaginas ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaAtual + 1)">&gt;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>

</div>