@model List<MVC_InventoryMasters.Models.MedicaoVolume>

@{
    ViewData["Title"] = "Medições";
    int paginaAtual = ViewBag.PaginaAtual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
    double volumeMedio = ViewBag.VolumeMedio ?? 0;
    DateTime? ultimaMedicao = ViewBag.UltimaMedicao;
    string statusAtual = ViewBag.Status ?? "";
    string origemAtual = ViewBag.Origem ?? "";
}

<div class="container-fluid px-4 mt-4 page-shell">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h2 class="page-title">Histórico de Medições</h2>
        <button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#filtrosMedicoes">
            <i class="bi bi-funnel"></i>
            Filtros
        </button>
    </div>

    <div class="summary-grid mb-4">
        <div class="metric-card accent-green">
            <span>Total</span>
            <strong>@totalRegistros</strong>
        </div>
        <div class="metric-card accent-success">
            <span>Volume médio</span>
            <strong>@volumeMedio.ToString("N2") m³</strong>
        </div>
        <div class="metric-card accent-warning">
            <span>Última medição</span>
            <strong>@(ultimaMedicao.HasValue ? ultimaMedicao.Value.ToString("dd/MM/yyyy HH:mm") : "-")</strong>
        </div>
        <div class="metric-card accent-danger">
            <span>Alertas</span>
            <strong>@ViewBag.TotalAlerta</strong>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4 collapse" id="filtrosMedicoes">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <form asp-action="Index" method="get" class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small">Data inicial</label>
                        <input type="date" name="dataInicio" value="@ViewBag.DataInicio" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Data final</label>
                        <input type="date" name="dataFim" value="@ViewBag.DataFim" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Status</label>
                        <select name="status" class="form-select">
                            <option value="">Todos</option>
                            <option value="Normal" selected="@(statusAtual == "Normal")">Normal</option>
                            <option value="Alerta" selected="@(statusAtual == "Alerta")">Alerta</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Origem</label>
                        <input type="text" name="origem" value="@origemAtual" class="form-control" placeholder="Kinect, Manual..." />
                    </div>
                    <div class="col-md-1 d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <div class="col-12">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpar filtros</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>Lista de medições</strong>
            <span class="text-muted small">Máximo de 10 registros por página</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 app-table">
                    <thead>
                        <tr>
                            <th>Volume medido</th>
                            <th>Origem da leitura</th>
                            <th>Status</th>
                            <th>Empresa</th>
                            <th>Data e hora</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var status = string.IsNullOrWhiteSpace(item.Status) ? "Sem status" : item.Status;
                                var badge = status.Equals("Normal", StringComparison.OrdinalIgnoreCase)
                                    ? "bg-success"
                                    : status.Equals("Alerta", StringComparison.OrdinalIgnoreCase)
                                        ? "bg-warning text-dark"
                                        : "bg-secondary";

                                <tr>
                                    <td class="fw-bold">@(item.VolumeMedido?.ToString("N2") ?? "0,00") m³</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.OrigemLeitura) ? "-" : item.OrigemLeitura)</td>
                                    <td><span class="badge @badge">@status</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Empresa) ? "Empresa atual" : item.Empresa)</td>
                                    <td>@(item.DataHora.HasValue ? item.DataHora.Value.ToString("dd/MM/yyyy HH:mm:ss") : "-")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Nenhuma medição encontrada.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="text-muted small">Total de registros: @totalRegistros</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(paginaAtual == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaAtual - 1)" asp-route-dataInicio="@ViewBag.DataInicio" asp-route-dataFim="@ViewBag.DataFim" asp-route-status="@statusAtual" asp-route-origem="@origemAtual">&lt;</a>
                        </li>
                        @for (int i = 1; i <= totalPaginas; i++)
                        {
                            <li class="page-item @(i == paginaAtual ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-dataInicio="@ViewBag.DataInicio" asp-route-dataFim="@ViewBag.DataFim" asp-route-status="@statusAtual" asp-route-origem="@origemAtual">@i</a>
                            </li>
                        }
                        <li class="page-item @(paginaAtual == totalPaginas ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaAtual + 1)" asp-route-dataInicio="@ViewBag.DataInicio" asp-route-dataFim="@ViewBag.DataFim" asp-route-status="@statusAtual" asp-route-origem="@origemAtual">&gt;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
