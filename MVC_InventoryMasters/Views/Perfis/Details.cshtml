@model MVC_InventoryMasters.Models.Perfil

@{
    ViewData["Title"] = "Detalhes do Perfil";
}

<div class="container-fluid px-4 mt-4 page-shell">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>@Model.Nome</strong>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Voltar</a>
        </div>
        <div class="card-body">
            <p class="text-muted">@Model.Descricao</p>
            <h6>Permissões</h6>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var permissao in Model.Permissoes)
                {
                    <span class="badge bg-success">@permissao</span>
                }
            </div>
        </div>
    </div>
</div>
