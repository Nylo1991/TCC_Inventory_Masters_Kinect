@model MVC_InventoryMasters.Models.Parceiro

@{
    ViewData["Title"] = "Excluir Parceiro";
}

<div class="card shadow-sm">

    <div class="card-header bg-danger text-white">
        <h4>Excluir Parceiro</h4>
    </div>

    <div class="card-body">

        <div class="alert alert-warning">

            Tem certeza que deseja excluir este parceiro?

        </div>

        <dl class="row">

            <dt class="col-sm-3">
                Nome
            </dt>

            <dd class="col-sm-9">
                @Model.Nome
            </dd>

            <dt class="col-sm-3">
                Email
            </dt>

            <dd class="col-sm-9">
                @Model.Email
            </dd>

            <dt class="col-sm-3">
                Telefone
            </dt>

            <dd class="col-sm-9">
                @Model.Telefone
            </dd>

        </dl>

        <form asp-action="DeleteConfirmed">

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <button type="submit"
                    class="btn btn-danger">

                Confirmar Exclusão

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Cancelar

            </a>

        </form>

    </div>

</div>