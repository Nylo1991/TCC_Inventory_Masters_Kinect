@model IEnumerable<MVC_InventoryMasters.Models.Parceiro>

@{
    ViewData["Title"] = "Parceiros";
    int paginaAtual = ViewBag.PaginaAtual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
    string ativoParam = ViewBag.Ativo != null ? ViewBag.Ativo.ToString().ToLower() : "";
}

<div class="container-fluid px-4 mt-4 page-shell">
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Sucesso"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["Erro"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h2 class="page-title">Parceiros</h2>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg"></i> Novo Parceiro</a>
            <button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#filtrosParceiros">
                <i class="bi bi-funnel"></i> Filtros
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4 collapse show" id="filtrosParceiros">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small">Nome, e-mail ou empresa</label>
                    <input type="text" name="termo" value="@ViewBag.Termo" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small">Data início</label>
                    <input type="date" name="dataInicio" value="@ViewBag.DataInicio" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small">Data fim</label>
                    <input type="date" name="dataFim" value="@ViewBag.DataFim" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small">Status</label>
                    <select name="ativo" class="form-select">
                        <option value="">Todos</option>
                        <option value="true" selected="@(ViewBag.Ativo == true)">Ativo</option>
                        <option value="false" selected="@(ViewBag.Ativo == false)">Inativo</option>
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Filtrar</button>
                </div>
                <div class="col-12">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpar filtros</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>Lista de parceiros</strong>
            <span class="text-muted small">@totalRegistros registro(s)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 app-table">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Empresa</th>
                            <th>E-mail</th>
                            <th>Telefone</th>
                            <th>Status</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var parceiro in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@parceiro.Nome</td>
                                    <td>@parceiro.Empresa</td>
                                    <td>@parceiro.Email</td>
                                    <td>@parceiro.Telefone</td>
                                    <td>
                                        <span class="badge @(parceiro.Ativo ? "bg-success" : "bg-warning text-dark")">
                                            @(parceiro.Ativo ? "Ativo" : "Inativo")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@parceiro.Id" title="Visualizar"><i class="bi bi-eye"></i></a>
                                            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@parceiro.Id" title="Editar"><i class="bi bi-pencil"></i></a>
                                            <form asp-action="AlternarStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@parceiro.Id" />
                                                <input type="hidden" name="ativo" value="@parceiro.Ativo.ToString().ToLower()" />
                                                <button type="submit" class="btn btn-outline-warning" title="Ativar/Inativar">
                                                    <i class="bi @(parceiro.Ativo ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">Nenhum parceiro encontrado.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="text-muted small">Total de registros: @totalRegistros</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(paginaAtual == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaAtual - 1)" asp-route-termo="@ViewBag.Termo" asp-route-dataInicio="@ViewBag.DataInicio" asp-route-dataFim="@ViewBag.DataFim" asp-route-ativo="@ativoParam">&lt;</a>
                        </li>
                        @for (int i = 1; i <= totalPaginas; i++)
                        {
                            <li class="page-item @(i == paginaAtual ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-termo="@ViewBag.Termo" asp-route-dataInicio="@ViewBag.DataInicio" asp-route-dataFim="@ViewBag.DataFim" asp-route-ativo="@ativoParam">@i</a>
                            </li>
                        }
                        <li class="page-item @(paginaAtual == totalPaginas ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaAtual + 1)" asp-route-termo="@ViewBag.Termo" asp-route-dataInicio="@ViewBag.DataInicio" asp-route-dataFim="@ViewBag.DataFim" asp-route-ativo="@ativoParam">&gt;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
