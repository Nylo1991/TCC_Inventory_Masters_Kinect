@model IEnumerable<MVC_InventoryMasters.Models.Parceiro>

@{
    ViewData["Title"] = "Parceiros";
    
    // Lógica para manter o filtro visível se o usuário estiver usando algum filtro
    bool filtroAtivo = !string.IsNullOrEmpty(ViewBag.Termo) ||
                       !string.IsNullOrEmpty(ViewBag.DataInicio) ||
                       !string.IsNullOrEmpty(ViewBag.DataFim) ||
                       ViewBag.Ativo != null;

    // Prepara o parâmetro de status para os links de paginação
    string ativoParam = ViewBag.Ativo != null ? ViewBag.Ativo.ToString().ToLower() : "";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Parceiros</h2>
        <div>
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-lg"></i> Novo Parceiro
            </a>
            <button class="btn btn-outline-primary border-2 ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#filtroAvancado">
                <i class="bi bi-funnel"></i> Filtros Avançados
            </button>
        </div>
    </div>

    <div class="collapse @(filtroAtivo ? "show" : "")" id="filtroAvancado">
        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-3">
                <h5 class="mb-0"><i class="bi bi-funnel"></i> Filtros Avançados</h5>
            </div>
            <div class="card-body">
                <form asp-action="Index" method="get" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small">Busca Geral</label>
                        <input type="text" name="termo" value="@ViewBag.Termo" class="form-control" placeholder="Nome, Empresa, Email...">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Data Início</label>
                        <input type="date" name="dataInicio" value="@ViewBag.DataInicio" class="form-control">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Data Fim</label>
                        <input type="date" name="dataFim" value="@ViewBag.DataFim" class="form-control">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Status</label>
                        <select name="ativo" class="form-select">
                            <option value="">Todos</option>
                            <option value="true" selected="@(ViewBag.Ativo == true)">Ativo</option>
                            <option value="false" selected="@(ViewBag.Ativo == false)">Inativo</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100 me-2">Filtrar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Nome</th>
                        <th>Empresa</th>
                        <th>Email</th>
                        <th>Telefone</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var parceiro in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@parceiro.Nome</td>
                            <td>@parceiro.Empresa</td>
                            <td>@parceiro.Email</td>
                            <td>@parceiro.Telefone</td>
                            <td class="text-center">
                                @if (parceiro.Ativo)
                                {
                                    <span class="badge bg-success">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Inativo</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">...</button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@parceiro.Id"><i class="bi bi-pencil"></i> Editar</a></li>
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@parceiro.Id"><i class="bi bi-eye"></i> Detalhes</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@parceiro.Id"><i class="bi bi-trash"></i> Excluir</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small">Total de registros: @ViewBag.TotalRegistros</span>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(ViewBag.PaginaAtual == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.PaginaAtual - 1)"
                               asp-route-termo="@ViewBag.Termo" asp-route-dataInicio="@ViewBag.DataInicio"
                               asp-route-dataFim="@ViewBag.DataFim" asp-route-ativo="@ativoParam">&lt;</a>
                        </li>
                        @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                        {
                            <li class="page-item @(i == ViewBag.PaginaAtual ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pagina="@i"
                                   asp-route-termo="@ViewBag.Termo" asp-route-dataInicio="@ViewBag.DataInicio"
                                   asp-route-dataFim="@ViewBag.DataFim" asp-route-ativo="@ativoParam">@i</a>
                            </li>
                        }
                        <li class="page-item @(ViewBag.PaginaAtual == ViewBag.TotalPaginas ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.PaginaAtual + 1)"
                               asp-route-termo="@ViewBag.Termo" asp-route-dataInicio="@ViewBag.DataInicio"
                               asp-route-dataFim="@ViewBag.DataFim" asp-route-ativo="@ativoParam">&gt;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>