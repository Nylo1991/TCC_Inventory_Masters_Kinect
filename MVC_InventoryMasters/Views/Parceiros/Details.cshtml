@model MVC_InventoryMasters.Models.Parceiro

@{
    ViewData["Title"] = "Detalhes do Parceiro";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Detalhes do Parceiro</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Voltar à Lista
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="row mb-3">
                <div class="col-sm-3 text-muted">Nome do Parceiro</div>
                <div class="col-sm-9 fw-bold">@Model.Nome</div>
            </div>
            <hr>
            <div class="row mb-3">
                <div class="col-sm-3 text-muted">Empresa</div>
                <div class="col-sm-9">@Model.Empresa</div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-3 text-muted">E-mail</div>
                <div class="col-sm-9">@Model.Email</div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-3 text-muted">Telefone</div>
                <div class="col-sm-9">@Model.Telefone</div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-3 text-muted">Endereço</div>
                <div class="col-sm-9">@Model.Endereco</div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-3 text-muted">Status</div>
                <div class="col-sm-9">
                    @if (Model.Ativo)
                    {
                        <span class="badge bg-success">Ativo</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Inativo</span>
                    }
                </div>
            </div>
        </div>
        <div class="card-footer bg-light p-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Editar Parceiro
            </a>
        </div>
    </div>
</div>