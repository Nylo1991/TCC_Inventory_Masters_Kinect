@model MVC_InventoryMasters.Models.ParametrosSistema

@{
    ViewData["Title"] = "Configurações";
}

<div class="container-fluid">

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Sucesso"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Erro"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Aviso"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            @TempData["Aviso"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <form id="formConfiguracoes"
          asp-controller="Parametros"
          asp-action="Salvar"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="row">

            <!-- ========================= -->
            <!-- CONFIGURAÇÕES DO SISTEMA -->
            <!-- ========================= -->

            <div class="col-lg-6 mb-4">

                <div class="card shadow-sm h-100">

                    <div class="card-header bg-primary text-white">

                        <h5 class="mb-0">
                            <i class="bi bi-sliders"></i>
                            Configurações do Sistema
                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="mb-3">

                            <label asp-for="CapacidadeMaxima"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="CapacidadeMaxima"
                                   type="number"
                                   min="1"
                                   step="0.01"
                                   class="form-control" />

                            <span asp-validation-for="CapacidadeMaxima"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="CapacidadeMinima"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="CapacidadeMinima"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   class="form-control" />

                            <span asp-validation-for="CapacidadeMinima"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="PercentualAlerta"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="PercentualAlerta"
                                   type="number"
                                   min="1"
                                   max="100"
                                   class="form-control" />

                            <span asp-validation-for="PercentualAlerta"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="alert alert-light border">

                            <strong>Objetivo:</strong>

                            Define a capacidade total do estoque e o
                            percentual que dispara alertas automáticos
                            quando o volume armazenado atingir níveis críticos.

                        </div>

                    </div>

                </div>

            </div>

            <!-- ============================== -->
            <!-- CONFIGURAÇÕES DE NOTIFICAÇÃO -->
            <!-- ============================== -->

            <div class="col-lg-6 mb-4">

                <div class="card shadow-sm h-100">

                    <div class="card-header bg-warning">

                        <h5 class="mb-0">
                            <i class="bi bi-bell"></i>
                            Configurações de Notificação
                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="form-check form-switch mb-3">

                            <input asp-for="NotificacaoAutomatica"
                                   class="form-check-input" />

                            <label asp-for="NotificacaoAutomatica"
                                   class="form-check-label fw-semibold">
                                Enviar notificações automáticas
                            </label>

                        </div>

                        <div class="form-check form-switch mb-3">

                            <input asp-for="ExibirAlertaDashboard"
                                   class="form-check-input" />

                            <label asp-for="ExibirAlertaDashboard"
                                   class="form-check-label fw-semibold">
                                Exibir alertas no Dashboard
                            </label>

                        </div>

                        <div class="mb-3">

                            <label asp-for="DiasSemColetaAlerta"
                                   class="form-label fw-semibold">

                                Dias sem coleta para gerar alerta

                            </label>

                            <input asp-for="DiasSemColetaAlerta"
                                   type="number"
                                   min="1"
                                   class="form-control" />

                        </div>

                        <div class="alert alert-warning border">

                            <strong><i class="bi bi-tools"></i> Funcionalidade em Desenvolvimento</strong>

                            <br />

                            Os parâmetros e configurações avançadas de notificações ainda estão em desenvolvimento
                            e serão disponibilizados em versões futuras do sistema.

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="card shadow-sm">

            <div class="card-body">

                <div class="d-flex gap-2">

                    <button id="btnSalvar"
                            type="submit"
                            class="btn btn-success"
                            disabled>

                        <i class="bi bi-check-circle"></i>
                        Salvar Alterações

                    </button>

                    <a asp-action="Index"
                       asp-controller="Home"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-left"></i>
                        Voltar

                    </a>

                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        const form =
            document.getElementById("formConfiguracoes");

        const btnSalvar =
            document.getElementById("btnSalvar");

        let alterado = false;

        form.querySelectorAll("input, select").forEach(campo => {

            campo.addEventListener("input", () => {

                if (!alterado)
                {
                    alterado = true;
                    btnSalvar.disabled = false;
                }

            });

            campo.addEventListener("change", () => {

                if (!alterado)
                {
                    alterado = true;
                    btnSalvar.disabled = false;
                }

            });

        });

            


    </script>
}