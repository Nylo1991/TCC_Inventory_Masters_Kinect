@model IEnumerable<MVC_InventoryMasters.Models.Notificacao>

@{
    ViewData["Title"] = "Histórico de Notificações";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0"><i class="bi bi-bell"></i> Histórico de Eventos</h5>
            <span class="badge bg-secondary">Total: @(Model?.Count() ?? 0)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Status</th>
                            <th>Data</th>
                            <th>Mensagem</th>
                            <th>Volume (m³)</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var n in Model)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge @(n.StatusEnvio == "Erro" ? "bg-danger" : "bg-info")">@n.StatusEnvio</span>
                                    </td>
                                    <td>@n.DataHora.ToString("dd/MM HH:mm")</td>
                                    <td>@n.Mensagem</td>
                                    <td><strong>@(n.VolumeMedido?.ToString("F2") ?? "0.00") m³</strong></td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    Nenhum histórico encontrado.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
