@model IEnumerable<MVC_InventoryMasters.Models.Notificacao>
@using MVC_InventoryMasters.Models

@{
    ViewData["Title"] = "Histórico de Notificações";
    var parceiros = ViewBag.Parceiros as List<Parceiro> ?? new List<Parceiro>();
    int paginaAtual = ViewBag.PaginaAtual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
    string statusAtual = ViewBag.Status ?? "";
    string tipoAtual = ViewBag.Tipo ?? "";
    string parceiroAtual = ViewBag.ParceiroId ?? "";
}

<div class="container-fluid px-4 mt-4 page-shell">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h2 class="page-title">Histórico de Notificações</h2>
        <button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#filtrosNotificacoes">
            <i class="bi bi-funnel"></i>
            Filtros
        </button>
    </div>

    <div class="summary-grid mb-4">
        <div class="metric-card accent-green">
            <span>Total</span>
            <strong>@totalRegistros</strong>
        </div>
        <div class="metric-card accent-success">
            <span>Sucesso</span>
            <strong>@ViewBag.TotalSucesso</strong>
        </div>
        <div class="metric-card accent-danger">
            <span>Com erro</span>
            <strong>@ViewBag.TotalErro</strong>
        </div>
        <div class="metric-card accent-warning">
            <span>Pendentes</span>
            <strong>@ViewBag.TotalPendente</strong>
        </div>
    </div>

    <div class="collapse show" id="filtrosNotificacoes">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <form asp-action="Index" method="get" class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small">Data inicial</label>
                        <input type="date" name="dataInicio" value="@ViewBag.DataInicio" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Data final</label>
                        <input type="date" name="dataFim" value="@ViewBag.DataFim" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Parceiro</label>
                        <select name="parceiroId" class="form-select">
                            <option value="">Todos</option>
                            @foreach (var parceiro in parceiros)
                            {
                                <option value="@parceiro.Id" selected="@(parceiroAtual == parceiro.Id)">@parceiro.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Status</label>
                        <select name="status" class="form-select">
                            <option value="">Todos</option>
                            <option value="Pendente" selected="@(statusAtual == "Pendente")">Pendente</option>
                            <option value="Aceito" selected="@(statusAtual == "Aceito")">Aceito</option>
                            <option value="Sucesso" selected="@(statusAtual == "Sucesso")">Sucesso</option>
                            <option value="Erro" selected="@(statusAtual == "Erro")">Erro</option>
                            <option value="Resolvido" selected="@(statusAtual == "Resolvido")">Resolvido</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Tipo</label>
                        <select name="tipo" class="form-select">
                            <option value="">Todos</option>
                            <option value="Capacidade" selected="@(tipoAtual == "Capacidade")">Capacidade</option>
                            <option value="Alerta" selected="@(tipoAtual == "Alerta")">Alerta</option>
                            <option value="Coleta" selected="@(tipoAtual == "Coleta")">Coleta</option>
                        </select>
                    </div>
                    <div class="col-md-1 d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <div class="col-12">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpar filtros</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>Notificações enviadas</strong>
            <span class="text-muted small">Ordenado por data mais recente</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 app-table">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Parceiro/Destinatário</th>
                            <th>Empresa</th>
                            <th>Tipo</th>
                            <th>Status</th>
                            <th>Mensagem</th>
                            <th>Volume</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var n in Model)
                            {
                                var parceiro = parceiros.FirstOrDefault(p => p.Id == n.ParceiroId);
                                var destinatario = parceiro?.Nome ?? n.Destinatario ?? "Sem destinatário";
                                var empresa = parceiro?.Empresa ?? n.Empresa ?? "Sem empresa";
                                var status = string.IsNullOrWhiteSpace(n.StatusEnvio) ? "Info" : n.StatusEnvio;
                                var badge = status switch
                                {
                                    "Pendente" => "bg-warning text-dark",
                                    "Aceito" => "bg-success",
                                    "Sucesso" => "bg-success",
                                    "Resolvido" => "bg-secondary",
                                    "Erro" => "bg-danger",
                                    _ => "bg-info text-dark"
                                };

                                <tr>
                                    <td>@n.DataHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="fw-semibold">@destinatario</td>
                                    <td>@empresa</td>
                                    <td><span class="badge bg-primary">@(string.IsNullOrWhiteSpace(n.Tipo) ? "Alerta" : n.Tipo)</span></td>
                                    <td><span class="badge @badge">@status</span></td>
                                    <td class="text-truncate-cell" title="@n.Mensagem">@n.Mensagem</td>
                                    <td>@(n.VolumeMedido?.ToString("N2") ?? "0,00") m³</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">Nenhuma notificação encontrada.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="text-muted small">Total de registros: @totalRegistros</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(paginaAtual == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaAtual - 1)" asp-route-dataInicio="@ViewBag.DataInicio" asp-route-dataFim="@ViewBag.DataFim" asp-route-parceiroId="@parceiroAtual" asp-route-status="@statusAtual" asp-route-tipo="@tipoAtual">&lt;</a>
                        </li>
                        @for (int i = 1; i <= totalPaginas; i++)
                        {
                            <li class="page-item @(i == paginaAtual ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-dataInicio="@ViewBag.DataInicio" asp-route-dataFim="@ViewBag.DataFim" asp-route-parceiroId="@parceiroAtual" asp-route-status="@statusAtual" asp-route-tipo="@tipoAtual">@i</a>
                            </li>
                        }
                        <li class="page-item @(paginaAtual == totalPaginas ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaAtual + 1)" asp-route-dataInicio="@ViewBag.DataInicio" asp-route-dataFim="@ViewBag.DataFim" asp-route-parceiroId="@parceiroAtual" asp-route-status="@statusAtual" asp-route-tipo="@tipoAtual">&gt;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
