@model MVC_InventoryMasters.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <!-- KPIs -->
    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-title">Parceiros</div>
                    <div class="dashboard-number">
                        @Model.Parceiros.Count
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-title">Usuários</div>
                    <div class="dashboard-number">
                        @Model.Usuarios.Count
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-title">Medições</div>
                    <div class="dashboard-number" id="totalMedicoes">
                        @Model.Medicoes.Count
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-title">Alertas</div>
                    <div class="dashboard-number">
                        @Model.Alertas.Count
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Últimos parceiros -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Últimos Parceiros</h5>
        </div>

        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Email</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var parceiro in Model.Parceiros.Take(5))
                    {
                        <tr>
                            <td>@parceiro.Nome</td>
                            <td>@parceiro.Email</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 🔥 LOG DE MEDIÇÕES (PRONTO PARA SIGNALR) -->
    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">📡 Medições em Tempo Real</h5>
        </div>

        <div class="card-body">
            <table class="table table-dark table-hover">
                <thead>
                    <tr>
                        <th>Volume</th>
                        <th>Origem</th>
                        <th>Status</th>
                        <th>Data</th>
                    </tr>
                </thead>

                <tbody id="logMedicoes">

                    @foreach (var m in Model.Medicoes.OrderByDescending(x => x.DataHora).Take(10))
                    {
                        <tr>
                            <td>@m.VolumeMedido</td>
                            <td>@m.OrigemLeitura</td>
                            <td>@m.Status</td>
                            <td>@m.DataHora</td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- SIGNALR -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/medicaoHub")
        .build();

    connection.start();

    connection.on("NovaMedicao", function (m) {

        // Atualiza contador
        let total = document.getElementById("totalMedicoes");
        total.innerText = parseInt(total.innerText) + 1;

        // Adiciona no topo do log
        let tabela = document.getElementById("logMedicoes");

        let row = `
            <tr>
                <td>${m.volumeMedido}</td>
                <td>${m.origemLeitura}</td>
                <td>${m.status}</td>
                <td>${m.dataHora}</td>
            </tr>
        `;

        tabela.insertAdjacentHTML("afterbegin", row);
    });
</script>