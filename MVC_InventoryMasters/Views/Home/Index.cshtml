@model IEnumerable<MVC_InventoryMasters.Models.Parceiro>

@{
    ViewData["Title"] = "Home Page";
}

<div class="container">

    <h1>Parceiros Cadastrados</h1>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var parceiro in Model)
            {
                <tr>
                    <td>@parceiro.Nome</td>
                    <td>@parceiro.Email</td>
                </tr>
            }

        </tbody>
    </table>

</div>