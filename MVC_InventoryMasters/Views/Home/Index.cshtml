@model IEnumerable<MVC_InventoryMasters.Models.Parceiro>

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-title">Parceiros</div>
                    <div class="dashboard-number">
                        @Model.Count()
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-title">Usuários</div>
                    <div class="dashboard-number">
                        @Model.Count()
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-title">Medições</div>
                    <div class="dashboard-number">
                        0
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-title">Alertas</div>
                    <div class="dashboard-number">
                        0
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Últimos Parceiros Cadastrados</h5>
        </div>

        <div class="card-body">

            <table class="table table-hover">

                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Email</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var parceiro in Model.Take(5))
                    {
                        <tr>
                            <td>@parceiro.Nome</td>
                            <td>@parceiro.Email</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>