@using MVC_InventoryMasters.Services
@inject PermissaoService Permissoes

@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var nomeUsuario = autenticado ? (User.Identity?.Name ?? "Usuário") : "Visitante";
    var perfilUsuario = User.FindFirst(ClaimTypes.Role)?.Value ?? User.FindFirst("Perfil")?.Value ?? "Sem perfil";
    var empresaUsuario = User.FindFirst("Empresa")?.Value;

    bool Pode(string permissao) =>
        autenticado && Permissoes.PerfilPossuiPermissao(perfilUsuario, permissao);
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Masters</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="wrapper">
        <aside class="sidebar">
            <div class="logo-area">
                <h4>Inventory Masters</h4>
                <small>Gestão de Estoque Inteligente</small>
            </div>

            <nav class="menu">
                @if (Pode(PermissoesSistema.DashboardVisualizar))
                {
                    <a asp-controller="Home" asp-action="Index" title="Visão geral do sistema">
                        <i class="bi bi-speedometer2"></i>
                        Dashboard
                    </a>
                }

                @if (Pode(PermissoesSistema.ParceirosVisualizar) || Pode(PermissoesSistema.ParceirosGerenciar))
                {
                    <a asp-controller="Parceiros" asp-action="Index" title="Gerenciar empresas parceiras e contatos">
                        <i class="bi bi-buildings"></i>
                        Parceiros
                    </a>
                }

                @if (Pode(PermissoesSistema.UsuariosGerenciar))
                {
                    <a asp-controller="Usuarios" asp-action="Index" title="Gerenciar usuários do sistema">
                        <i class="bi bi-people"></i>
                        Usuários
                    </a>
                }

                @if (Pode(PermissoesSistema.PerfisGerenciar))
                {
                    <a asp-controller="Perfis" asp-action="Index" title="Gerenciar perfis e permissões">
                        <i class="bi bi-person-lock"></i>
                        Perfis
                    </a>
                }

                @if (Pode(PermissoesSistema.MedicoesVisualizar))
                {
                    <a asp-controller="Medicoes" asp-action="Index" title="Consultar medições de volume">
                        <i class="bi bi-rulers"></i>
                        Medições
                    </a>
                }

                @if (Pode(PermissoesSistema.NotificacoesVisualizar))
                {
                    <a asp-controller="Notificacoes" asp-action="Index" title="Histórico de alertas enviados">
                        <i class="bi bi-bell"></i>
                        Notificações
                    </a>
                }

                @if (Pode(PermissoesSistema.ConfiguracoesGerenciar))
                {
                    <a asp-controller="Parametros" asp-action="Index" title="Configurar limites e parâmetros do sistema">
                        <i class="bi bi-gear"></i>
                        Configurações
                    </a>
                }

                @if (!autenticado)
                {
                    <a asp-controller="Acesso" asp-action="Login" title="Entrar no sistema">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Login
                    </a>
                }

                
            </nav>
            <div class="sidebar-footer">
                <form asp-controller="Acesso" asp-action="Sair" method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn-logout">
                        <i class="bi bi-box-arrow-right"></i>
                        Encerrar Sessão
                    </button>
                </form>
            </div>
        </aside>

        <div class="main-content">
            <header class="topbar">
                <div class="d-flex align-items-center gap-3">
                    <button id="sidebarToggle" class="btn btn-light btn-sm" type="button">
                        <i class="bi bi-list"></i>
                    </button>
                    <h5 class="m-0">@ViewData["Title"]</h5>
                </div>

                <div class="user-info">
                    @if (autenticado)
                    {
                        <div class="user-pill">
                            <i class="bi bi-person-circle"></i>
                            <span>
                                <strong>@nomeUsuario</strong>
                                <small>@perfilUsuario@(string.IsNullOrWhiteSpace(empresaUsuario) ? "" : $" • {empresaUsuario}")</small>
                            </span>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Acesso" asp-action="Login" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-box-arrow-in-right"></i>
                            Entrar
                        </a>
                    }
                </div>
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="modal fade" id="modalEmDesenvolvimento" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">
                        <i class="bi bi-tools"></i>
                        Funcionalidade em Desenvolvimento
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    Esta funcionalidade ainda está em desenvolvimento e será disponibilizada em versões futuras do sistema.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Entendi</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"], [title]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            const sidebarToggle = document.getElementById("sidebarToggle");

            if (sidebarToggle) {
                sidebarToggle.addEventListener("click", function () {
                    document.querySelector(".wrapper").classList.toggle("collapsed");
                });
            }
        });

        function exibirFuncionalidadeEmDesenvolvimento(mensagem) {
            const modalBody = document.querySelector("#modalEmDesenvolvimento .modal-body");

            if (modalBody) {
                modalBody.innerText = mensagem;
            }

            const modal = new bootstrap.Modal(document.getElementById("modalEmDesenvolvimento"));
            modal.show();
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
