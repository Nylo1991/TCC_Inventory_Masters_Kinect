@model MVC_InventoryMasters.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">


    <!-- KPIs -->
    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-title">Parceiros</div>
                    <div class="dashboard-number">
                        @(Model.Parceiros?.Count ?? 0)
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-title">Usuários</div>
                    <div class="dashboard-number">
                        @(Model.Usuarios?.Count ?? 0)
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-title">Medições</div>
                    <div class="dashboard-number" id="totalMedicoes">
                        @(Model.Medicoes?.Count ?? 0)
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-title">Alertas</div>
                    <div class="dashboard-number">
                        @(Model.Alertas?.Count ?? 0)
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Gráfico -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">📊 Volume em Tempo Real</h5>
        </div>

        <div class="card-body">
            <canvas id="volumeChart" height="100"></canvas>
        </div>
    </div>

    <!-- Últimos Parceiros -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Últimos Parceiros</h5>
        </div>

        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Email</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Parceiros != null && Model.Parceiros.Any())
                    {
                        foreach (var parceiro in Model.Parceiros
                        .OrderByDescending(p => p.Id)
                        .Take(5))
                        {
                            <tr>
                                <td>@parceiro.Nome</td>
                                <td>@parceiro.Email</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Log de Medições -->
    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">📡 Medições em Tempo Real</h5>
        </div>

        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Volume  (m³)</th>
                        <th>Data</th>
                    </tr>
                </thead>

                <tbody id="logMedicoes">

                    @if (Model.Medicoes != null && Model.Medicoes.Any())
                    {
                        foreach (var m in Model.Medicoes
                        .OrderByDescending(x => x.DataHora)
                        .Take(10))
                        {
                            <tr>
                                <td>@(m.VolumeMedido?.ToString("N2") ?? "0,00")</td>
                                <td>@m.DataHora</td>
                            </tr>
                        }
                    }

                </tbody>

            </table>
        </div>
    </div>


</div>

<!-- Toast -->

<div id="toast"
     style="
        position: fixed;
        top: 20px;
        right: 20px;
        background: #1f2937;
        color: white;
        padding: 12px 18px;
        border-radius: 8px;
        display: none;
        z-index: 9999;
        box-shadow: 0 4px 12px rgba(0,0,0,.3);">
</div>

@section Scripts
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        // ======================================
        // DADOS INICIAIS VINDOS DO FIRESTORE
        // ======================================

        const medicoesIniciais = [
        @if (Model.Medicoes != null && Model.Medicoes.Any())
        {
                foreach (var m in Model.Medicoes
                        .OrderBy(x => x.DataHora)
                        .TakeLast(20))
                {
                        <text>
                        {
                            volume: @(m.VolumeMedido ?? 0),
                            data: "@(m.DataHora?.ToString("HH:mm:ss"))"
                        },
                        </text>
                }
        }
        ];

        // ======================================
        // TOAST
        // ======================================

        function showToast(message) {

            const toast =
                document.getElementById("toast");

            toast.innerText = message;
            toast.style.display = "block";

            setTimeout(() => {
                toast.style.display = "none";
            }, 3000);
        }

        // ======================================
        // PREPARA DADOS DO GRÁFICO
        // ======================================

        const labelsIniciais =
            medicoesIniciais.map(x => x.data);

        const volumesIniciais =
            medicoesIniciais.map(x => x.volume);

        // ======================================
        // CHART
        // ======================================

        const ctx =
            document
                .getElementById("volumeChart")
                .getContext("2d");

        const volumeChart =
            new Chart(ctx, {
                type: "line",
                data: {
                    labels: labelsIniciais,
                    datasets: [{
                        label: "Volume Medido",
                        data: volumesIniciais,
                        borderColor: "#16a34a",
                        backgroundColor: "rgba(22,163,74,0.15)",
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    animation: false,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });

        // ======================================
        // SIGNALR
        // ======================================

        const connection =
            new signalR.HubConnectionBuilder()
                .withUrl("/medicaoHub")
                .withAutomaticReconnect()
                .build();

        connection.start()
            .then(() => {

                console.log("SignalR conectado");
                showToast("Conectado ao servidor");

            })
            .catch(err => {

                console.error(err);
                showToast("Erro ao conectar ao servidor");

            });

        connection.onreconnecting(() => {

            console.warn("Reconectando...");
            showToast("Reconectando...");

        });

        connection.onreconnected(() => {

            console.log("Reconectado");
            showToast("Conexão restabelecida");

        });

        connection.onclose(() => {

            console.error("Conexão encerrada");
            showToast("Conexão perdida");

        });

        // ======================================
        // NOVA MEDIÇÃO
        // ======================================

        connection.on("NovaMedicao", function (m) {

            console.log("Nova medição recebida:", m);

            const volume =
                Number(m.volumeMedido || 0);

            const hora =
                new Date().toLocaleTimeString();

            // KPI

            const totalMedicoes =
                document.getElementById("totalMedicoes");

            if (totalMedicoes) {

                totalMedicoes.innerText =
                    Number(totalMedicoes.innerText || 0) + 1;
            }

            // TABELA

            const tabela =
                document.getElementById("logMedicoes");

            if (tabela) {

                const row = `
                    <tr>
                        <td>${m.volumeMedido ?? "-"}</td>
                        <td>${m.origemLeitura ?? "-"}</td>
                        <td>${m.status ?? "-"}</td>
                        <td>${m.dataHora ?? "-"}</td>
                    </tr>
                `;

                tabela.insertAdjacentHTML(
                    "afterbegin",
                    row);

                while (tabela.rows.length > 20) {

                    tabela.deleteRow(
                        tabela.rows.length - 1);
                }
            }

            // GRÁFICO

            volumeChart.data.labels.push(hora);

            volumeChart.data.datasets[0].data.push(volume);

            if (volumeChart.data.labels.length > 20) {

                volumeChart.data.labels.shift();

                volumeChart.data.datasets[0].data.shift();
            }

            volumeChart.update();

            // ALERTA

            
        });

    </script>
}
