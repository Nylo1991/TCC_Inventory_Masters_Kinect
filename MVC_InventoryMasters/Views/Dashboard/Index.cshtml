@model MVC_InventoryMasters.ViewModels.DashboardViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Dashboard";
}
<div class="container-fluid">
    <div class="card shadow-sm mb-4">
        <div class="card-header"><h5 class="mb-0">📊 (m³) Volume em tempo real </h5></div>
        <div class="card-body">
            <canvas id="volumeChart" height="100"></canvas>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header"><h5 class="mb-0">🔔 Últimas notificações enviadas</h5></div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">                       
                        <thead>
                            <tr>
                                <th>Parceiro</th>
                                <th>Mensagem</th>
                                <th>Volume (m³)</th>
                                <th>Data</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Alertas != null)
                            {
                                foreach (var n in Model.Alertas.OrderByDescending(x => x.DataHora).Take(5))
                                {
                                    // Busca o parceiro correspondente pelo ID
                                    var p = Model.Parceiros?.FirstOrDefault(x => x.Id == n.ParceiroId);

                                    <tr>
                                        <td>
                                            @if (p != null)
                                            {
                                                <div><strong>@p.Nome</strong></div>
                                                <small class="text-muted"><i class="bi bi-envelope"></i> @p.Email</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Sem parceiro</span>
                                            }
                                        </td>
                                        <td>@n.Mensagem</td>
                                        <td><strong>@(n.VolumeMedido?.ToString("F2") ?? "0.00") m³</strong></td>
                                        <td>@n.DataHora.ToString("dd/MM HH:mm")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header"><h5 class="mb-0">📈 % de Ocupação do estoque</h5></div>
                <div class="card-body">
                    <canvas id="occupancyChart" style="max-height: 250px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-3"><div class="card text-center p-3 shadow-sm"><div class="dashboard-title">Parceiros</div><div class="dashboard-number">@(Model.Parceiros?.Count ?? 0)</div></div></div>
        <div class="col-md-3"><div class="card text-center p-3 shadow-sm"><div class="dashboard-title">Usuários</div><div class="dashboard-number">@(Model.Usuarios?.Count ?? 0)</div></div></div>
        <div class="col-md-3"><div class="card text-center p-3 shadow-sm"><div class="dashboard-title">Medições</div><div class="dashboard-number" id="totalMedicoes">@(Model.Medicoes?.Count ?? 0)</div></div></div>
        <div class="col-md-3"><div class="card text-center p-3 shadow-sm"><div class="dashboard-title">Alertas</div><div class="dashboard-number">@(Model.Alertas?.Count ?? 0)</div></div></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let occupancyChart;
        let volumeChart;

        const initialPercent = parseFloat("@Model.PercentualOcupacao.ToString(CultureInfo.InvariantCulture)");
        const capacidadeTotal = @(Model.Parametros?.CapacidadeMaxima.ToString(CultureInfo.InvariantCulture) ?? "1000.0");
        const percentualAlerta = @(Model.Parametros?.PercentualAlerta ?? 80);

        function obterCorOcupacao(percentual) {
        if (percentual >= percentualAlerta) return '#dc2626';
        if (percentual >= (percentualAlerta - 20)) return '#eab308';
        return '#16a34a';
        }

        const connection = new signalR.HubConnectionBuilder()
        .withUrl("/medicaoHub")
        .build();
        
        const ctxVolume = document.getElementById('volumeChart').getContext('2d');
        volumeChart = new Chart(ctxVolume, {
        type: 'line',
        data: { labels: [], datasets: [{ label: 'Volume (m³)', data: [], borderColor: '#16a34a', fill: false, tension: 0.3 }] },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
        y: {
        beginAtZero: true,
        suggestedMax: capacidadeTotal
        }
        }
        }
        });

        const ctxOcupacao = document.getElementById('occupancyChart').getContext('2d');
        occupancyChart = new Chart(ctxOcupacao, {
        type: 'doughnut',
        data: {
        labels: ['Ocupado', 'Livre'],
        datasets: [{
        data: [initialPercent, 100 - initialPercent],
        backgroundColor: [obterCorOcupacao(initialPercent), '#e5e7eb']
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom' } }
        }
        });

        connection.on("NovaMedicao", function (m) {
        const novoVolume = Number(m.volumeMedido || 0);
        const novoPercentual = Math.min((novoVolume / capacidadeTotal) * 100, 100);

        // Atualiza Gráfico de Ocupação
        occupancyChart.data.datasets[0].data = [novoPercentual, 100 - novoPercentual];
        occupancyChart.data.datasets[0].backgroundColor = [obterCorOcupacao(novoPercentual), '#e5e7eb'];
        occupancyChart.update();

        // Atualiza Gráfico de Volume
        volumeChart.data.labels.push(new Date().toLocaleTimeString());
        volumeChart.data.datasets[0].data.push(novoVolume);
       // if (volumeChart.data.labels.length > 10) {
       // volumeChart.data.labels.shift();
       // volumeChart.data.datasets[0].data.shift();
       // }
        volumeChart.update();
        });

        connection.start().catch(err => console.error(err.toString()));
    </script>
}