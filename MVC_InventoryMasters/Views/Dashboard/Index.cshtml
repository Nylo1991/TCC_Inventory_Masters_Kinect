@model MVC_InventoryMasters.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <div class="card shadow-sm mb-4">
        <div class="card-header"><h5 class="mb-0">📊 Volume em Tempo Real</h5></div>
        <div class="card-body">
            <canvas id="volumeChart" height="100"></canvas>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header"><h5 class="mb-0">Últimos Parceiros</h5></div>
                <div class="card-body">
                    <table class="table table-hover">
                        <thead><tr><th>Nome</th><th>Email</th></tr></thead>
                        <tbody>
                            @foreach (var p in Model.Parceiros.OrderByDescending(x => x.Id).Take(5))
                            {
                                <tr><td>@p.Nome</td><td>@p.Email</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header"><h5 class="mb-0">📡 Medições em Tempo Real</h5></div>
                <div class="card-body">
                    <table class="table table-hover">
                        <thead><tr><th>Volume (m³)</th><th>Data</th></tr></thead>
                        <tbody id="logMedicoes">
                            @foreach (var m in Model.Medicoes.OrderByDescending(x => x.DataHora).Take(5))
                            {
                                <tr>
                                    <td>@(m.VolumeMedido?.ToString("N2") ?? "0,00")</td>
                                    <td>@m.DataHora</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card text-center p-3 shadow-sm">
                <div class="dashboard-title">Parceiros</div>
                <div class="dashboard-number">@(Model.Parceiros?.Count ?? 0)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3 shadow-sm">
                <div class="dashboard-title">Usuários</div>
                <div class="dashboard-number">@(Model.Usuarios?.Count ?? 0)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3 shadow-sm">
                <div class="dashboard-title">Medições</div>
                <div class="dashboard-number" id="totalMedicoes">@(Model.Medicoes?.Count ?? 0)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3 shadow-sm">
                <div class="dashboard-title">Alertas</div>
                <div class="dashboard-number">@(Model.Alertas?.Count ?? 0)</div>
            </div>
        </div>
    </div>
</div>