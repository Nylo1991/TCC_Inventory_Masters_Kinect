@model MVC_InventoryMasters.ViewModels.DashboardViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Dashboard";
    
    var percentualOcupacao = Model.PercentualOcupacao.ToString(CultureInfo.InvariantCulture);
    var capacidadeMaxima = (Model.Parametros?.CapacidadeMaxima != null
                                ? Convert.ToDouble(Model.Parametros.CapacidadeMaxima)
                                : 1000.0).ToString(CultureInfo.InvariantCulture);
    var percAlerta = (Model.Parametros?.PercentualAlerta != null
                                ? Convert.ToDouble(Model.Parametros.PercentualAlerta)
                                : 80.0).ToString(CultureInfo.InvariantCulture);
}

<div class="container-fluid py-3">
    @* Cabecalho *@
    <div class="d-flex align-items-center gap-3 mb-3">
        <h5 class="mb-0 fw-bold">Monitoramento de Volume em Tempo Real</h5>
    </div>

    @* Volume e Ocupação *@
    <div class="row g-3 mb-3">
        <div class="col-md-8">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold">Medições Kinect</h6>
                </div>
                <div class="card-body">
                    <canvas id="volumeChart" height="130"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold">% de Ocupação do Estoque</h6>
                </div>
                <div class="card-body d-flex flex-column align-items-center justify-content-center">
                    <canvas id="occupancyChart" style="max-height: 220px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    @* Tabela de Notificações e Cards *@
    <div class="row g-3">
        <div class="col-md-8">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold">Últimas notificações enviadas</h6>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Status de Envio</th>
                                <th>Parceiro</th>
                                <th>Mensagem</th>
                                <th>Volume</th>
                                <th>Data</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Alertas != null && Model.Alertas.Any())
                            {
                                foreach (var n in Model.Alertas.OrderByDescending(x => x.DataHora).Take(5))
                                {
                                    var p = Model.Parceiros?.FirstOrDefault(x => x.Id == n.ParceiroId);
                                    <tr>
                                        <td>
                                            @if (n.StatusEnvio == "Aceito")
                                            {
                                                <span class="badge bg-success">Aceito</span>
                                            }
                                            else if (n.StatusEnvio == "Erro")
                                            {
                                                <span class="badge bg-danger">Erro</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info text-dark">Info</span>
                                            }
                                        </td>
                                        <td>
                                            @if (p != null)
                                            {
                                                <strong>@p.Nome</strong>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Sem parceiro</span>
                                            }
                                        </td>
                                        <td>@n.Mensagem</td>
                                        <td>
                                            <strong>@(n.VolumeMedido?.ToString("F2") ?? "0.00") m&sup3;</strong>
                                        </td>
                                        <td>@n.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">Nenhuma notificação encontrada.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="row g-3 h-100">
                <div class="col-6">
                    <div class="card text-center p-3 shadow-sm h-100" style="border: 2px solid #16a34a; border-radius: 12px;">
                        <div class="fw-semibold mb-1" style="color:#16a34a; font-size:0.9rem;">Parceiros:</div>
                        <div class="fw-bold" id="cardParceiros" style="font-size: 2.8rem; line-height:1.1; color:#111;">
                            @(Model.Parceiros?.Count ?? 0)
                        </div>
                    </div>
                </div>

                <div class="col-6">
                    <div class="card text-center p-3 shadow-sm h-100" style="border: 2px solid #2563eb; border-radius: 12px;">
                        <div class="fw-semibold mb-1" style="color:#2563eb; font-size:0.9rem;">Usuários:</div>
                        <div class="fw-bold" id="cardUsuarios" style="font-size: 2.8rem; line-height:1.1; color:#111;">
                            @(Model.Usuarios?.Count ?? 0)
                        </div>
                    </div>
                </div>

                <div class="col-6">
                    <div class="card text-center p-3 shadow-sm h-100" style="border: 2px solid #d97706; border-radius: 12px;">
                        <div class="fw-semibold mb-1" style="color:#d97706; font-size:0.9rem;">Medições:</div>
                        <div class="fw-bold" id="totalMedicoes" style="font-size: 2.8rem; line-height:1.1; color:#111;">
                            @(Model.Medicoes?.Count ?? 0)
                        </div>
                    </div>
                </div>

                <div class="col-6">
                    <div class="card text-center p-3 shadow-sm h-100" style="border: 2px solid #dc2626; border-radius: 12px;">
                        <div class="fw-semibold mb-1" style="color:#dc2626; font-size:0.9rem;">Alertas:</div>
                        <div class="fw-bold" id="cardAlertas" style="font-size: 2.8rem; line-height:1.1; color:#111;">
                            @(Model.Alertas?.Count ?? 0)
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var initialPercent = parseFloat("@percentualOcupacao");
        var capacidadeTotal = parseFloat("@capacidadeMaxima");
        var percentualAlerta = parseFloat("@percAlerta");

        function obterCorOcupacao(percentual) {
        if (percentual >= percentualAlerta) return '#dc2626';
        if (percentual >= (percentualAlerta - 20)) return '#eab308';
        return '#16a34a';
        }

        // Conexões SignalR
        var connectionMed = new signalR.HubConnectionBuilder()
        .withUrl("/medicaoHub")
        .withAutomaticReconnect()
        .build();

        var connectionNotif = new signalR.HubConnectionBuilder()
        .withUrl("/notificacaoHub")
        .withAutomaticReconnect()
        .build();

        // Gráfico de Linha
                // Gráfico de Linha
        var ctxVolume = document.getElementById('volumeChart').getContext('2d');

        var labelsIniciais = [
        @foreach (var medicao in Model.Medicoes?
            .OrderByDescending(x => x.DataHora)
            .Take(20)
            .Reverse() ?? Enumerable.Empty<dynamic>())
        {
                <text>'@medicao.DataHora?.ToLocalTime().ToString("HH:mm:ss")',</text>
        }
        ];

        var dadosIniciais = [
        @foreach (var medicao in Model.Medicoes?
            .OrderByDescending(x => x.DataHora)
            .Take(20)
            .Reverse() ?? Enumerable.Empty<dynamic>())
        {
                <text>@((medicao.VolumeMedido ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture)),</text>
        }
        ];

        var volumeChart = new Chart(ctxVolume, {
            type: 'line',
            data: {
                labels: labelsIniciais,
                datasets: [{
                    label: 'Volume (m³)',
                    data: dadosIniciais,
                    borderColor: '#16a34a',
                    backgroundColor: 'rgba(22,163,74,0.08)',
                    fill: true,
                    tension: 0.3,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        grace: '5%',
                        ticks: {
                            callback: function(value) {
                                return value.toFixed(2) + ' m³';
                            }
                        }
                    }
                }
            }
        });

        // Gráfico de Ocupação
        var ctxOcupacao = document.getElementById('occupancyChart').getContext('2d');
        var occupancyChart = new Chart(ctxOcupacao, {
        type: 'doughnut',
        data: {
        labels: ['Ocupado', 'Livre'],
        datasets: [{
        data: [initialPercent, 100 - initialPercent],
        backgroundColor: [obterCorOcupacao(initialPercent), '#e5e7eb'],
        borderWidth: 2
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom' } }
        }
        });

        // Nova Medição do Kinect
                connectionMed.on("NovaMedicao", function (m) {

            var novoVolume =
                parseFloat(m.volumeMedido || 0);

            var novoPercentual =
                Math.min(
                    (novoVolume / capacidadeTotal) * 100,
                    100
                );

            occupancyChart.data.datasets[0].data = [
                novoPercentual.toFixed(1),
                (100 - novoPercentual).toFixed(1)
            ];

            occupancyChart.data.datasets[0].backgroundColor = [
                obterCorOcupacao(novoPercentual),
                '#e5e7eb'
            ];

            occupancyChart.update();

            if (volumeChart.data.labels.length >= 20)
            {
                volumeChart.data.labels.shift();
                volumeChart.data.datasets[0].data.shift();
            }

            volumeChart.data.labels.push(
                new Date().toLocaleTimeString()
            );

            volumeChart.data.datasets[0].data.push(
                Number(novoVolume.toFixed(3))
            );

            volumeChart.update();

            var elMedicoes =
                document.getElementById('totalMedicoes');

            if (elMedicoes)
            {
                elMedicoes.innerText =
                    parseInt(elMedicoes.innerText || '0') + 1;
            }
        });

        connectionNotif.on("RecarregarTabela", function () { location.reload(); });

        connectionMed.start().catch(function (err) { console.error("Erro Hub: " + err); });
        connectionNotif.start().catch(function (err) { console.error("Erro Notif: " + err); });
    </script>
}