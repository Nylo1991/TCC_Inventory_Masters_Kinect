@model MVC_InventoryMasters.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <!-- KPIs -->
    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-title">Parceiros</div>
                    <div class="dashboard-number">
                        @(Model.Parceiros?.Count ?? 0)
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-title">Usuários</div>
                    <div class="dashboard-number">
                        @(Model.Usuarios?.Count ?? 0)
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-title">Medições</div>
                    <div class="dashboard-number" id="totalMedicoes">
                        @(Model.Medicoes?.Count ?? 0)
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="dashboard-title">Alertas</div>
                    <div class="dashboard-number">
                        @(Model.Alertas?.Count ?? 0)
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- 📊 GRÁFICO EM TEMPO REAL -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5>📊 Volume em Tempo Real</h5>
        </div>

        <div class="card-body">
            <canvas id="volumeChart" height="100"></canvas>
        </div>
    </div>

    <!-- Últimos parceiros -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Últimos Parceiros</h5>
        </div>

        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Email</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Parceiros != null && Model.Parceiros.Any())
                    {
                        foreach (var parceiro in Model.Parceiros
                        .OrderByDescending(p => p.Id)
                        .Take(5))
                        {
                            <tr>
                                <td>@parceiro.Nome</td>
                                <td>@parceiro.Email</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 📡 LOG EM TEMPO REAL -->
    <div class="card shadow-sm">
        <div class="card-header">
            <h5>📡 Medições em Tempo Real</h5>
        </div>

        <div class="card-body">
            <table class="table table-dark table-hover">
                <thead>
                    <tr>
                        <th>Volume</th>
                        <th>Origem</th>
                        <th>Status</th>
                        <th>Data</th>
                    </tr>
                </thead>

                <tbody id="logMedicoes">

                    @if (Model.Medicoes != null && Model.Medicoes.Any())
                    {
                        foreach (var m in Model.Medicoes
                        .OrderByDescending(x => x.DataHora)
                        .Take(10))
                        {
                            <tr>
                                <td>@m.VolumeMedido</td>
                                <td>@m.OrigemLeitura</td>
                                <td>@m.Status</td>
                                <td>@m.DataHora</td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- TOAST ALERT -->
<div id="toast" style="
    position: fixed;
    top: 20px;
    right: 20px;
    background: #333;
    color: white;
    padding: 10px 15px;
    border-radius: 5px;
    display: none;
    z-index: 9999;">
</div>

<!-- LIBS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // =========================
    // CHART SETUP
    // =========================
    const ctx = document.getElementById("volumeChart").getContext("2d");

    const volumeData = {
        labels: [],
        datasets: [{
            label: "Volume",
            data: [],
            borderColor: "green",
            backgroundColor: "rgba(0,255,0,0.1)",
            tension: 0.3
        }]
    };

    const volumeChart = new Chart(ctx, {
        type: "line",
        data: volumeData,
        options: {
            responsive: true,
            animation: false,
            scales: {
                y: { beginAtZero: true }
            }
        }
    });

    // =========================
    // TOAST FUNCTION
    // =========================
    function showToast(msg) {
        const toast = document.getElementById("toast");
        toast.innerText = msg;
        toast.style.display = "block";

        setTimeout(() => {
            toast.style.display = "none";
        }, 2500);
    }

    // =========================
    // SIGNALR
    // =========================
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/medicaoHub")
        .build();

    connection.start()
        .catch(err => console.error("SignalR error:", err));

    connection.on("NovaMedicao", function (m) {

        let volume = parseFloat(m.volumeMedido ?? 0);
        let hora = new Date().toLocaleTimeString();

        // =========================
        // KPI
        // =========================
        const total = document.getElementById("totalMedicoes");
        if (total) {
            total.innerText = parseInt(total.innerText || "0") + 1;
        }

        // =========================
        // LOG
        // =========================
        const tabela = document.getElementById("logMedicoes");

        if (tabela) {
            const row = `
                <tr>
                    <td>${m.volumeMedido ?? ""}</td>
                    <td>${m.origemLeitura ?? ""}</td>
                    <td>${m.status ?? ""}</td>
                    <td>${m.dataHora ?? ""}</td>
                </tr>
            `;
            tabela.insertAdjacentHTML("afterbegin", row);
        }

        // =========================
        // GRÁFICO
        // =========================
        volumeChart.data.labels.push(hora);
        volumeChart.data.datasets[0].data.push(volume);

        if (volumeChart.data.labels.length > 20) {
            volumeChart.data.labels.shift();
            volumeChart.data.datasets[0].data.shift();
        }

        volumeChart.update();

        // =========================
        // ALERTA VISUAL
        // =========================
        if (volume > 80) {
            showToast("🚨 ALERTA: Volume alto detectado!");
        } else {
            showToast("📡 Nova medição recebida");
        }
    });
</script>