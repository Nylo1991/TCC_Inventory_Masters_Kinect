@model MVC_InventoryMasters.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuário";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Editar Usuário</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Voltar à Lista
        </a>
    </div>

    @if (ViewBag.Aviso != null)
    {
        <div class="alert alert-warning">@ViewBag.Aviso</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input asp-for="Id" type="hidden" />
                <input asp-for="Data_Cadastro" type="hidden" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Perfil" class="form-label"></label>
                        <select asp-for="Perfil" asp-items="ViewBag.Perfis" class="form-select">
                            <option value="">Selecione um perfil...</option>
                        </select>
                        <span asp-validation-for="Perfil" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Ativo" class="form-check-input" />
                    <label asp-for="Ativo" class="form-check-label">Usuário Ativo</label>
                </div>

                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-lg"></i> Salvar Alterações
                </button>
            </form>
        </div>
    </div>
</div>