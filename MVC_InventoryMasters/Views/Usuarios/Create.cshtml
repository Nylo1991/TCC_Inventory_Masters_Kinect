@model MVC_InventoryMasters.Models.Usuario

@{
    ViewData["Title"] = "Novo Usuário";
}

<div class="container">

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4>Novo Usuário</h4>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">

                    <label asp-for="Perfil" class="form-label">
                        Perfil
                    </label>

                    <select asp-for="Perfil"
                            asp-items="ViewBag.Perfis"
                            class="form-select">

                        <option value="">
                            Selecione um perfil
                        </option>

                    </select>

                    <span asp-validation-for="Perfil"
                          class="text-danger"></span>

                </div>

                <div class="mb-3">
                    <label asp-for="Senha" class="form-label"></label>
                    <input asp-for="Senha" type="password" class="form-control" />
                    <span asp-validation-for="Senha" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="Ativo" class="form-check-input" />
                    <label class="form-check-label">Usuário Ativo</label>
                    <span asp-validation-for="Ativo" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success">
                    Salvar
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>
    </div>
</div>